	month = oct,
	year = {2010},
	pages = {668--673},
	file = {Moign et al. - 2010 - Life cycle assessment of using powder and liquid p.pdf:files/4708/Moign et al. - 2010 - Life cycle assessment of using powder and liquid p.pdf:application/pdf},
}

