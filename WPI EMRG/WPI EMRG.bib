@techreport{noauthor_tricia_2026,
	title = {Tricia {K}. {Jedele}, {Esq}. {Offshore} {Wind} {Policy} {Manager}},
	url = {https://www.nature.org/content/dam/tnc/nature/en/documents/t/n/TNC-OSW-Technical-Report_vFINAL_2026-08-17.pdf},
	abstract = {Connecticut and New England today face several pressures: electricity prices are up 27\%since 2020, peak demand is expected to grow and shift to the winter, and the generation mixis dependent on natural gas, which has seen increased volatility in recent years. Against thisbackdrop, Dunsky Energy + Climate Advisors, contracted by The Nature Conservancy,evaluated the economic competitiveness of offshore wind within a diversified resourceportfolio for ISO-NE, using capacity expansion modeling and levelized cost of energy (LCOE)analysis.

We modeled three capacity expansion scenarios over a 2035 to 2050 planning horizon,assuming a natural gas price of \$6/MMBtu, and evaluated each of these scenarios against twodemand forecasts:

• Scenario 1 - All Fossil and Nuclear: New renewables and storage are excluded; onlydual-fuel combined cycle gas turbines (CCGTs) and small modular reactors (SMRs) areavailable for expansion.
• Scenario 2 - Least-Cost Mix: All technologies compete based on the direct ratepayercost likely to be included in regional electric bills (offshore wind, land-based wind,solar, battery storage, SMRs, and CCGTs), with land-based wind capped at 3.6 GW dueto siting constraints.
• Scenario 3 - All Clean: New CCGT construction is prohibited, and a declining carbonbudget is imposed.

Importantly, carbon pricing or climate policies were not included. This was a deliberatechoice to test offshore wind’s competitiveness based on direct utility economics rather than abroader societal perspective. This is not meant to suggest that these policies should beignored; instead, our analysis demonstrates that offshore wind remains a prominent andpromising resource for New England regardless of the policy scenario.},
	language = {en},
	urldate = {2026-10-06},
	institution = {The Nature Conservancy},
	month = aug,
	year = {2026},
	file = {Coronato - Tricia K. Jedele, Esq. Offshore Wind Policy Manage.pdf:files/6499/Coronato - Tricia K. Jedele, Esq. Offshore Wind Policy Manage.pdf:application/pdf},
}

@article{dung_fabrication_2020,
	title = {Fabrication of magnetocaloric {La}({Fe},{Si})13 thick films},
	volume = {127},
	issn = {0021-8979, 1089-7550},
	url = {https://pubs.aip.org/jap/article/127/21/215103/566059/Fabrication-of-magnetocaloric-La-Fe-Si-13-thick},
	doi = {10.1063/5.0006324},
	abstract = {La(Fe,Si)13-based compounds are considered to be very promising magnetocaloric materials for magnetic refrigeration applications. Many studies have focused on this material family but only in bulk form. In this paper, we report the fabrication of thick films of La(Fe,Si)13, both with and without post-hydriding. These films exhibit magnetic and structural properties comparable to those of bulk materials. We also observe that the ferromagnetic phase transition has a negative thermal hysteresis, a phenomenon not previously found in this material but which may have its origins in the availability of a strain energy reservoir, as in the cases of other materials in which negative thermal hysteresis has been found. Here, it appears that the substrate acts to store strain energy. Our exploratory study demonstrates the viability of thick films of the La(Fe,Si)13 phase and motivates further work in the area, while showing that additional perspectives can be gained from reducing the dimensionality of magnetocaloric materials in which the magneto-volume effect is large.},
	language = {en},
	number = {21},
	urldate = {2026-10-05},
	journal = {Journal of Applied Physics},
	author = {Dung, N. H. and Doan, N. B. and De Rango, P. and Ranno, L. and Sandeman, K. G. and Dempsey, N. M.},
	month = jun,
	year = {2020},
	pages = {215103},
}

@article{nehan_magnetocaloric_2024,
	title = {The magnetocaloric effect properties for potential applications of magnetic refrigerator technology: a review},
	volume = {26},
	issn = {1463-9076, 1463-9084},
	shorttitle = {The magnetocaloric effect properties for potential applications of magnetic refrigerator technology},
	url = {https://pubs.rsc.org/cp/article/26/20/14476-14504/842912},
	doi = {10.1039/D4CP01077A},
	abstract = {In pursuing a clean and environmentally friendly future, a magnetic refrigerator based on the magnetocaloric effect has been proposed to replace conventional refrigeration characterized by inefficient energy use and greenhouse gas emissions.
          , 
            
              In the pursuit of a clean and environmentally friendly future, magnetic refrigerator technology based on the magnetocaloric effect has been proposed as a replacement for conventional refrigeration technologies characterized by inefficient energy use, greenhouse gas emissions, and ozone depletion. This paper presents an in-depth exploration of the current state of research on magnetocaloric effect (MCE) materials by, examining various types of MCE materials and their respective potentials. The focus is particularly directed towards perovskite manganite materials because of their numerous advantages over other materials. These advantages include a wide working temperature range, easily adjustable Curie temperature around room temperature, excellent chemical stability, cost-effective production processes, negligible magnetic and thermal hysteresis properties, as well as competitive values for −Δ
              S
              M
              and Δ
              T
              ad
              compared to other materials. Additionally, crucial parameters defining the MCE properties of perovskite manganite materials are comprehensively discussed, both at a fundamental level and in detail.},
	language = {en},
	number = {20},
	urldate = {2026-10-05},
	journal = {Phys. Chem. Chem. Phys.},
	author = {Nehan, Phahul Zhemas Zul and Vitayaya, Okvarahireka and Munazat, Dicky Rezky and Manawan, Maykel T. E. and Darminto, Darminto and Kurniawan, Budhy},
	year = {2024},
	pages = {14476--14504},
}

