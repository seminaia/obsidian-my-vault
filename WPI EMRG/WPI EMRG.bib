@article{chen_praseodymium-cerium_2012,
	title = {Praseodymium-cerium oxide thin film cathodes: {Study} of oxygen reduction reaction kinetics},
	volume = {28},
	issn = {1385-3449, 1573-8663},
	shorttitle = {Praseodymium-cerium oxide thin film cathodes},
	url = {http://link.springer.com/10.1007/s10832-011-9678-z},
	doi = {10.1007/s10832-011-9678-z},
	abstract = {Praseodymium-Cerium Oxide (PrxCe1-xO2−δ; PCO), a potential three way catalyst oxygen storage material and solid oxide fuel cell (SOFC) cathode, exhibits surprisingly high levels of oxygen nonstoichiometry, even under oxidizing (e.g. air) conditions, resulting in mixed ionic electronic conductivity (MIEC). In this study we examine the redox kinetics of dense PCO thin films using impedance spectroscopy, for x00.01, 0.10 and 0.20, over the temperature range of 550 to 670°C, and the oxygen partial pressure range of 10−4 to 1 atm O2. The electrode impedance was observed to be independent of electrode thickness and inversely proportional to electrode area, pointing to surface exchange rather than bulk diffusion limited kinetics. The large electrode capacitance (10−2F) was found to be consistent with an expected large electrochemically induced change in stoichiometry for x00.1 and x00.2 PCO. The PCO films showed surprisingly rapid oxygen exchange kinetics, comparable to other high performance SOFC cathode materials, from which values for the surface exchange coefficient, kq, were calculated. This study confirms the suitability of PCO as a model MIEC cathode material compatible with both zirconia and ceria based solid oxide electrolytes.},
	language = {en},
	number = {1},
	urldate = {2020-06-10},
	journal = {J Electroceram},
	author = {Chen, Di and Bishop, Sean R. and Tuller, Harry L.},
	month = feb,
	year = {2012},
	pages = {62--69},
	annote = {This looks most suitable for a non-aqueous electrolyte, which might or might not work for Mg.  The best would be a low-melting salt where MgO would fall off of the Mg cathode after formation.},
	file = {Chen et al. - 2012 - Praseodymium-cerium oxide thin film cathodes Stud.pdf:files/5620/Chen et al. - 2012 - Praseodymium-cerium oxide thin film cathodes Stud.pdf:application/pdf},
}

