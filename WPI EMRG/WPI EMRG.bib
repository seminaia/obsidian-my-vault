@phdthesis{adiasa_dissolution_2023,
	address = {Aachen, Germany},
	type = {Master of {Science}},
	title = {Dissolution {Behavior} and {Kinetic} {Investigation} of {Sulfur} in a {Ferronickel} {Melt}},
	abstract = {The dissolution characteristics of sulfur and the kinetics of sulfidation in molten ferronickel through qualitative and quantitative measurements was investigated in this thesis. This involved injecting liquid sulfur from the top of the melt and assessing the sulfidation rate by collecting melt samples using vacuum tubes. To interpret the data on mass transfer, well-established mass transfer theory was applied to interpret the results in a fundamental manner by penetration theory. A kinetic rate equation was derived to model the experimental data. The experimental findings were interpreted in terms of the rate at which sulfur was transferred from which also the boundary layer thickness could be derived for a given diffusivity 𝐷 of S in the liquid phase. Solution thermodynamics of the Fe-Ni-S system was included in the interpretation. The underlying assumption was that the absorption reaction was primarily governed by diffusion in the liquid phase, with gas-phase diffusion considered negligible. It was observed that the sulfidation rate remained relatively consistent as sulfur concentration increased. When considering the dissolution behavior, it was noted that upon injection, liquid sulfur vaporized and formed a single large bubble, and a significant portion of mass transfer occurred through this single bubble into the melt.},
	language = {en},
	school = {RWTH Aachen University},
	author = {Adiasa, Damara},
	month = nov,
	year = {2023},
	file = {PUB_20231102_Master Thesis Adiasa.pdf:files/3661/PUB_20231102_Master Thesis Adiasa.pdf:application/pdf},
}

