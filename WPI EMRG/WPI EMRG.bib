@techreport{engel_transition_2020-4,
	title = {{TRANSITION} {FASTER} {TOGETHER} - {Renewables}},
	url = {https://download.dnvgl.com/transition_faster_together_2020},
	abstract = {The resilience of renewable energy sources to deliver power to our homes and to commercial and industrial settings has been tested again, this time during the coronavirus crisis. Solar and wind power generation has demonstrated that it can reliably supply a larger proportion of energy demand.
With the continuing lowering cost of energy for onshore and offshore wind projects, and the availability of lower cost, efficient solar modules, combined with advanced energy storage solutions, we predict another significant rise in renewables deployment this decade.
But the predicted growth in renewables is far from enough to meet the climate goals of the Paris Agreement. We have so many promising technologies at our disposal, but we still need to do much more to increase the scale and speed of fully decarbonized energy solutions, as well as expand and reinforce power grids to become fit for the future. We all need to promote new ideas, share innovation and proven solutions. And crucially, we need policies and regulation to support this. We need to find ways to work together to transition much faster towards a clean energy future for the benefit of all of us.},
	language = {en},
	urldate = {2020-08-12},
	institution = {DNV GL},
	author = {Engel, Ditlev},
	month = jul,
	year = {2020},
