@incollection{alam_molten_2023,
	address = {Cham},
	title = {Molten {Salt} {Mg}-{Air} {Battery} {Improvement} and {Recharging}},
	isbn = {978-3-031-22637-3 978-3-031-22638-0},
	url = {https://link.springer.com/10.1007/978-3-031-22638-0_17},
	doi = {10.1007/978-3-031-22638-0_17},
	abstract = {Decarbonization of the shipping industry along with other long-haul transportation is among the toughest and most important challenges to resolve toward greenhouse emission elimination. A molten salt magnesium-air battery shows promise toward meeting this challenge. This work presents the improvement achieved in long-run battery performance through solidifying the MgO reaction product from the molten salt electrolyte by using a cold ﬁnger. Moreover, preliminary result on Mg reduction at the battery anode is discussed which leads to the recharging of these batteries. Finally, a battery design in a 20-foot shipping container could deliver 60–90 MWh of energy, which is 15–22 times the energy of containerized lithiumion batteries, at a fraction of the cost. Disadvantages include the inability to scale down due to high-temperature operation, and lower round-trip efﬁciency than Li-ion batteries.},
	language = {en},
	urldate = {2023-04-04},
	booktitle = {Energy {Technology} 2023},
	publisher = {Springer Nature Switzerland},
	author = {Shahabi, Mahya and Masse, Nicholas and Lota, Amanda and Wallace, Lucien and Bastow, Heath and Powell, Adam},
	editor = {Alam, Shafiq and Guillen, Donna Post and Tesfaye, Fiseha and Zhang, Lei and Hockaday, Susanna A.C. and Neelameggham, Neale R. and Peng, Hong and Haque, Nawshad and Liu, Yan},
	year = {2023},
	note = {Series Title: The Minerals, Metals \& Materials Series},
	pages = {171--179},
	file = {Shahabi et al. - 2023 - Molten Salt Mg-Air Battery Improvement and Recharg.pdf:files/4023/Shahabi et al. - 2023 - Molten Salt Mg-Air Battery Improvement and Recharg.pdf:application/pdf},
}

@incollection{spatocco_cost-based_2015,
	title = {Cost-{Based} {Discovery} for {Engineering} {Solutions}},
	isbn = {978-3-527-33345-5},
	doi = {10.1002/9783527690633.ch7},
	abstract = {This chapter sets forth a methodology of cost-based discovery through the example of grid-level storage. In the form of a case study, the chapter sets forth a method to address the challenge of grid-scale storage and integration of intermittent renewables by the discovery of next-generation liquid metal battery (LMB) chemistries with the view to advance the system's ability to deliver energy at low levelized costs for extended lifetimes. LMBs, due to their simple construction, are both of low cost and predictably scalable at the sizes required to solve storage needs on the grid. Temperature has been identified as a variable that can be adjusted to provide "cascading" reductions on final assembly cost and to bring the device below the threshold for ubiquitous deployment. By adopting a cost-based discovery model, it is believed that successful completion of the work would make a difference in the marketplace.},
	author = {Spatocco, Brian and Sadoway, Donald},
	month = aug,
	year = {2015},
	pages = {227--262},
	file = {Full Text PDF:files/4025/Spatocco and Sadoway - 2015 - Cost-Based Discovery for Engineering Solutions.pdf:application/pdf},
}

@article{toba_electrolytic_2013,
	title = {Electrolytic {Reduction} of {SiO2} {Granules} in {Molten} {CaCl2}},
	volume = {81},
	issn = {1344-3542, 2186-2451},
	url = {https://www.jstage.jst.go.jp/article/electrochemistry/81/7/81_13-1-E2612/_article},
	doi = {10.5796/electrochemistry.81.559},
	abstract = {Direct electrolytic reduction of SiO2 was investigated in molten CaCl2 at 1123 K as a fundamental study to develop a continuous process for solar-grade Si production. Several different types of SiO2 granules, as well as SiO2 pellets, were successfully reduced to Si on the bottom cathode of a Si plate. Three parameters were varied in the reduction of SiO2 granules: electrode potential, layer thickness of the SiO2 granules, and SiO2 particle size. The reduction rate was evaluated by the magnitude of the reduction current. The main factor determining the reduction rate was the diffusion of O2− ions inside the reduced porous Si layer ﬁlled with the electrolyte. Another factor which inﬂuenced the reduction rate was the contact resistance between Si granules.},
	language = {en},
	number = {7},
	urldate = {2023-04-04},
	journal = {Electrochemistry},
	author = {Toba, Tetsuya and Yasuda, Kouji and Nohira, Toshiyuki and Yang, Xiao and Hagiwara, Rika and Ichitsubo, Koki and Masuda, Kenta and Homma, Takayuki},
	year = {2013},
	pages = {559--565},
	file = {Toba et al. - 2013 - Electrolytic Reduction of SiO2 Granules in Molten .pdf:files/4026/Toba et al. - 2013 - Electrolytic Reduction of SiO2 Granules in Molten .pdf:application/pdf},
}

