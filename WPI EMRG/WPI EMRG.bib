@article{kong_hybrid_2026,
	title = {A {Hybrid} {Electrolyte}-{Based} {Reversible} {Direct} {Carbon} {Fuel} {Cell} for {In}-{Situ} {CO}$_{\textrm{2}}$ {Utilization} and {Energy} {Conversion}},
	volume = {173},
	issn = {0013-4651, 1945-7111},
	url = {https://iopscience.iop.org/article/10.1149/1945-7111/ae7473},
	doi = {10.1149/1945-7111/ae7473},
	abstract = {Harnessing Martian atmospheric CO
              2
              for in situ energy conversion and storage is crucial for sustainable extraterrestrial exploration. Solid carbon outperforms gaseous media as an energy carrier, offering superior energy density and storage stability. Herein, we demonstrate a novel hybrid electrolyte-based reversible direct carbon fuel cell (R-DCFC) capable of cyclic CO
              2
              -to-carbon for energy storage and in situ power generation. This cycle is realized in a blind tubular cell configuration with the YSZ/molten carbonate hybrid electrolyte. At 800 °C, the cell achieved stable CO
              2
              electrolysis (2.5 V, 2000 s) at 90 mA cm
              −2
              , depositing a porous carbon layer. This performance stems from the dual-ion (O
              2−
              /CO
              3
              2−
              ) reaction-transport coupling mechanism facilitated by the hybrid electrolyte. Subsequently, utilizing the in situ deposited carbon, the cell exhibited a peak power density of 21.1 mW cm
              −2
              with sustained discharge. The enhanced power output arises from superior interfacial contact: unlike externally supplied fuels, the in situ grown porous carbon ensures continuous electronic connectivity with electrode and effectively retains molten salt electrolyte via capillarity, maximizing the triple-phase boundary. Verified by electrochemical and microstructural analyses, this work validates the feasibility of the CO
              2
              -C cycle as a high energy density strategy for closed-loop energy conversion towards the in situ utilization of Martian CO
              2
              resources.},
	language = {en},
	number = {12},
	urldate = {2026-09-08},
	journal = {J. Electrochem. Soc.},
	author = {Kong, Jiale and Jiang, Yidong and Shi, Yixiang},
	month = jun,
	year = {2026},
	pages = {124506},
	file = {PDF:files/6446/Kong et al. - 2026 - A Hybrid Electrolyte-Based Reversible Direct Carbon Fuel Cell for In-Situ COsub2sub Utilization.pdf:application/pdf},
}

