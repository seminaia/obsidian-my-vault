	file = {Kubíková et al. - 2016 - Physicochemical Properties of the (LiF + CaF .pdf:files/5181/Kubíková et al. - 2016 - Physicochemical Properties of the (LiF + CaF .pdf:application/pdf},
}

@article{seregin_solubility_nodate,
	title = {Solubility of {UF4}, {ThF4}, and {CeF3} in a {LiF}–{NaF}–{KF} {Melt}},
	abstract = {The solubility of UF4, ThF4, and CeF3 in fluoride melt of the composition 45 mol \% LiF–12 mol \% NaF–43 mol \% KF in the temperature interval 773–973 K was determined. The solubility of the fluorides increases with an increase in the melt temperature. The CeF3 solubility in the LiF–NaF–KF system is high: 19.9 mol \% at 923 K and 23.3 mol \% at 973 K. Experimental data on the solubility of CeF3 (PuF3 imitator) were compared to the calculated data on the PuF3 solubility in the LiF–NaF–KF melt. The results showed that CeF3 can be considered as PuF3 imitator in FLINAK melt.},
