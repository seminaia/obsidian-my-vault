	title = {Minimum {Energy} {Loss} {Through} a {High}-{Temperature} {Electrolysis} {Lead}},
	abstract = {A high-temperature electrolysis cell loses heat through its leads if they have high thermal conductivity.  If electrical conductivity is low, then lead resistance will waste energy. Unfortunately, thermal  conductivity and electrical conductivity are coupled through the Wiedmann-Franz law, so a material which makes a good lead for thermal loss purposes is a bad one for electrical losses. This little paper quantitatively describes that trade-off and proposes a simple optimum for use as a design criterion.},
	language = {en},
	author = {Powell, Adam},
	month = mar,
	year = {2010},
	note = {Unpublished, the only other place I've seen this is Shahabuddin et al. 2022.},
