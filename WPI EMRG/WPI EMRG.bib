}

@inproceedings{wodin-schwartz_compensatory_2022,
	address = {Minneapolis, Minnesota, USA},
	title = {Compensatory {Effects} of {Flipped} {Learning} for {Experienced} \& {New} {Faculty}},
	url = {https://peer.asee.org/41370},
	abstract = {Flipping learning is an approach that has garnered attention in recent decades for providing deeper learning experience to students. In traditional engineering classes the lecturer feeds knowledge to the students in a classroom, describing concepts and explaining how to use them to solve problems, then students go off and solve those problems as homework assignments. In flipped learning, students learn concepts before coming to lecture, then practice solving problems in the classroom. This approach allows students to learn at their own pace, and get more help in the classroom with their problem-solving challenges. Fostering these benefits of flipped learning may be particularly useful to new faculty. If students are able to learn on their own, then the new faculty member can spend less time preparing to teach concepts, and more time learning how students approach problems - and understanding their problem-solving challenges. This paper describes efforts in one university’s mechanical engineering department to share flipped classroom curricula and pedagogies with two early career faculty members and with a mid-career faculty member with a new teaching assignment. A faculty member received internal teaching innovation grant support to redesign Introduction to Statics, a core course required of many engineering degrees, to a flipped structure.},
	language = {en},
	urldate = {2022-09-08},
	publisher = {American Society for Engineering Education},
	author = {Wodin-Schwartz, Sarah and Lechasseur, Kimberly and Powell, Adam and Zheng, Yihao and Narra, Sneha Prabha},
	month = jun,
	year = {2022},
	file = {Wodin-Schwartz et al. - Compensatory Effects of Flipped Learning for Exper.pdf:files/4461/Wodin-Schwartz et al. - Compensatory Effects of Flipped Learning for Exper.pdf:application/pdf},
}

