	url = {https://doi.org/10.1179/1879139513Y.0000000084},
	doi = {10.1179/1879139513Y.0000000084},
	abstract = {The processes for rare earth (RE) extraction include the decomposition of RE minerals, and the concurrent or subsequent leaching of the rare earth elements (REEs) from the decomposed minerals. Ore beneficiation concentrate can be decomposed by, for example, acid roasting, caustic cracking, and chlorination. The REEs can be selectively extracted. The nature of the REE extraction process depends on the type of minerals in the concentrate, the grade of the concentrate and the targeted products. This paper reviews RE extraction from the major RE minerals, including bastnaesite, monazite, xenotime, ion absorption clay, allanite, cerite, and eudialyte. An update on the development of RE extraction processes is also provided.Les procédés d’extraction de terre rare (TR) incluent la décomposition des minéraux de TR et la lixiviation concurrente ou subséquente des éléments de terre rare (ETRs) à partir des minéraux décomposés. On peut décomposer le concentré d’enrichissement du minerai, par exemple, par grillage acide, par craquage caustique ou par chloration. On peut extraire sélectivement les ETRs. La nature du procédé d’extraction de l’ETR dépend du type de minéraux dans le concentré, de la qualité du concentré et des produits cibles. Cet article examine l’extraction de TR à partir des minéraux majeurs de TR, incluant la bastnaésite, la monazite, le xénotime, l’argile à absorption d’ion, l’allanite, la cérite et l’eudialyte. On fait également une mise à jour du développement des procédés d’extraction de TR.},
	number = {3},
	urldate = {2023-01-30},
	journal = {Canadian Metallurgical Quarterly},
	publisher = {Taylor \& Francis},
	author = {Zhang, J and Edwards, C},
	month = jul,
	year = {2013},
	note = {\_eprint: https://doi.org/10.1179/1879139513Y.0000000084},
	keywords = {Chlorination, Acid roasting, Bastnaesite, Caustic cracking, Ion absorption type rare earth, Monazite, Rare earth, Xenotime},
	pages = {243--248},
}

@article{gupta_extractive_1992,
	title = {Extractive metallurgy of rare earths},
	volume = {37},
	issn = {0950-6608},
	url = {https://doi.org/10.1179/imr.1992.37.1.197},
	doi = {10.1179/imr.1992.37.1.197},
	abstract = {A comprehensive review is presented of the extractive metallurgy of rare earths. The topics covered are: world rare earth resources and production; ore processing and separation of individual rare earths; reduction, refining, and ultrapurification of rare earth elements; methods for rare earth materials analysis; and a selection of the numerous rare earth applications. World rare earth reserves are abundant and would last for well beyond the next century. However, all of the 16 naturally occurring rare earth elements are not equally distributed in the ore minerals. This, compounded with the problems specific to the isolation and recovery of each of the rare earths, sets the stage for an unequal rare earth availability. The close chemical similarity of rare earths looses its importance when divergent physical properties determine the processes for rare earth element reduction and refining. The rare earth metals, alloys, and compounds have been as pure as could be determined. Finally, the commercial demand for a rare earth has often been out of phase with its chemical availability. The review addresses itself to these points while providing a summary of the substantial body of information presently available on the extractive metallurgy of rare earths.},
	number = {1},
	urldate = {2023-01-30},
	journal = {International Materials Reviews},
	publisher = {Taylor \& Francis},
	author = {Gupta, C. K. and Krishnamurthy, N.},
	month = jan,
	year = {1992},
	note = {\_eprint: https://doi.org/10.1179/imr.1992.37.1.197},
	pages = {197--248},
}

@incollection{zhang_chapter_2015,
	series = {Including {Actinides}},
	title = {Chapter 277 - {Progress} in the {Separation} {Processes} for {Rare} {Earth} {Resources}},
	volume = {48},
	url = {https://www.sciencedirect.com/science/article/pii/B9780444634832000041},
	doi = {10.1016/B978-0-444-63483-2.00004-1},
	abstract = {Rare earth elements (REs) are a set of 17 elements including the 15 lanthanides plus scandium and yttrium, which have unique and widespread applications in magnetism, photoluminescence, catalysts, lasers, and among others. However, individual REs exhibit different intrinsic properties in optics, electrics, magnetism, or catalysis, so the separation and purification of RE concentrates are necessary for their uses in different applications. Importantly, the development of the separation and purification of rare earths is suffering from environmental problems and sustainable utilization of the resources. This review gives an overview of the progress in fundamental research and separation processes for rare earths. First, the progresses in rare earth extractants, novel equipments, technology, and theoretical modeling are summarized. Then industrial hydrometallurgy processes are discussed and compared to each other for different kinds of ores. The purification and preparation of high-purity rare earths or associated elements such as thorium, and the preparation of rare earth metals are also discussed. The issues of easily accessible resources and environmentally friendly processes are essential issues to deal with in order to ensure sustainable developments in rare earth metallurgy. In view of the growth of rare earth industry, efficient and comprehensive utilization and cleaner metallurgy of rare earths should still be a focus in the future.},
	language = {en},
	urldate = {2023-01-30},
	booktitle = {Handbook on the {Physics} and {Chemistry} of {Rare} {Earths}},
	publisher = {Elsevier},
	author = {Zhang, Zhifeng and Jia, Qiong and Liao, Wuping},
	editor = {Bünzli, Jean-Claude and Pecharsky, Vitalij K.},
	month = jan,
	year = {2015},
	keywords = {Separation, Rare earths, Hydrometallurgy, Purification},
	pages = {287--376},
	file = {ScienceDirect Snapshot:files/4272/B9780444634832000041.html:text/html},
}

@book{eyring_progress_2013,
	title = {Progress in the {Science} and {Technology} of the {Rare} {Earths}},
	isbn = {978-1-4832-2688-0},
	abstract = {Progress in the Science and Technology of the Rare Earths, Volume 1 is a 16-chapter text that brings together significant advances in understanding the scientific and technological aspects of rare earths. The first chapters deal with the geochemical properties, mass extraction, separation, fractionation, and solution chemistry of rare earths (RE). The next chapter related the U.S.S.R. efforts in delineating the chemistry of RE and in the discovery of other groups of substances for separation of RE mixtures. These topics are followed by discussions on phase equilibrium properties of RE and other oxides in mixed systems; the crystal chemistry of RE derivatives; physical and structural properties of alloys and intermetallic compounds; and the thermodynamic and magnetic properties of RE chalcogenides. The final chapter discusses the technical, industrial, and commercial applications of RE, with emphasis on their metallurgical potential. This book is of value to inorganic and organic chemists and researchers in the allied fields.},
	language = {en},
	publisher = {Elsevier},
	author = {Eyring, Leroy},
	month = sep,
	year = {2013},
	note = {Google-Books-ID: NaZmDAAAQBAJ},
