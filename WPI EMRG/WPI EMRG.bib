@phdthesis{thompson_investigation_1961,
	address = {Raleigh, North Carolina},
	title = {Investigation of {Structure} and {Properties} of {Certain} {Iron}-{Tin}-{Carbon} {Alloys}},
	url = {https://mit-worldcat-org.libproxy.mit.edu/oclc/4437662755},
	abstract = {Alloys in the composition range, 10 to 15 wt\% tin and 0.35 to 0.85 wt\% carbon, were found to be unforgeable. The forgeability problems were related to the configuration of the carbide in the microstructure, to the increased hardness of ferrite by solution of tin, and probably to the formation of thin films around grain boundaries. Mechanical tests showed that these alloys possessed very low impact strength with high hardness, in the range of Rockwell C-38 to 4l, and no apparent ductility. The liquidus projection of the iron-rich corner of the system was established experimentally. It was found to exhibit both a ternary eutectic and a ternary monotectic reaction. Carbon and tin analyses were made on all samples used in the liquidus determination. The positions of the alloying atoms in the iron--tin ternary carbide unit cell were determined by x-ray methods. The structure was found to be similar to the perovskite structure with some carbon vacancies and random substitution of two iron atoms for tin atoms in the corner sites.},
	language = {en},
