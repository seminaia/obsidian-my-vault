@techreport{sheehy_commercial_2019,
	title = {Commercial {Aircraft}: {Electric} {Propulsion}? {Fantasy} versus reality; {Implications} for new aircraft},
	abstract = {Electric aircraft have taken on a higher profile recently, partly because there are viable niche uses (drones, flight training, "pseudo-satellites"), and partly because of Tesla leading the move to battery-electric cars. Electric motors have attractive features: simple, reliable, cheap, flexible, scalable, unaffected by altitude, and nearly as powerful as gas turbines.

For mainline airline travel, do NOT expect a Tesla-style battery-electric revolution: batteries will not be good enough for the foreseeable future. Battery-electric power could, however, offer short-range urban mobility. There is excitement about the idea of "flying cars/taxis". Players, including Airbus, Bell, Boeing, Embraer, Uber, and Larry Page have jumped in. There are also likely other applications for electric vertical takeoff/landing (e-VTOL) aircraft.

Hybrid propulsion systems could become relevant to mainline air travel – but, not before the late 2030s, and likely requiring significantly different aircraft designs. Hybrid propulsion systems would use a combination of gas turbines and electric motors. Electric motors could drive separate propulsors, for example, for boundary layer ingestion or tip vortex energy recovery; or could provide a thrust boost near the top of the aircraft's climb to altitude. Here, batteries would be less important, although lightweight high-power electrical generators, motors, and power management systems would be vital.

We expect no impact from hybrid propulsion systems on Airbus or Boeing mainline product offerings in the early 2030s, when a new single-aisle might come. The OEMs would have to decide about hybrid propulsion long before 2030, as hybrid propulsion is not an add-on: it affects the aircraft's basic design. Program launch always comes at least 5-6 years before entry into service. But, hybrid systems would require years of demonstration on smaller aircraft for certification. Given challenges and risks related to these technologies (and certification complexity), we see the impact as still far into the future.

On very short-haul flights, plug-in hybrid aircraft could offer useful fuel and maintenance savings. Plug-in hybrids cut their fuel costs by using energy drawn from the electrical grid, to reduce jet fuel use. With current batteries, range would be limited to about 600 nautical miles, but half of all departures in the US today, with 30\% of passengers, are on flights no longer than that. Small plug-in hybrids ({\textasciitilde}nine passengers) could enter service in the 2020s. Evolutionary electrification should pose little threat to Airbus, Boeing, or engine OEMs. Small hybrid commuters will not threaten Airbus' or Boeing's mainline franchises, but, could add smaller opportunities in short-haul markets. GE, Rolls-Royce, Pratt and Safran are working on hybrid propulsion now. Still, we may see new long-term players. Siemens, for example, is investing in electric aircraft motors today.

Fuel cells could be a wild card, potentially displacing gas turbines in hybrids. The engine OEMs – Rolls-Royce, Pratt, Safran, GE – have little or no advantage in fuel cells (both Rolls-Royce and Pratt \& Whitney discontinued fuel cell programs in the past). But, fuel cells are far from competitive with gas turbines now, and progress appears slow.},
	language = {en},
	institution = {Bernstein Research},
	author = {Sheehy, Finbar and Harned, Douglas S and Newman, Mark C and Laughlin, Christian A and Cho, Ike and Wang, Hanxu},
	month = feb,
	year = {2019},
	file = {Sheehy et al. - 2019 - Commercial Aircraft Electric Propulsion Fantasy .PDF:files/4516/Sheehy et al. - 2019 - Commercial Aircraft Electric Propulsion Fantasy .PDF:application/pdf},
}

