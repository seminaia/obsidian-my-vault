@article{tamamura_new_1991,
	title = {New industrial process for electrowinning of {Nd}-{Fe} alloy. {Yoyuen} wo mochiita {Nd}-{Fe} gokin no denkai saishu},
	volume = {59:6},
	url = {https://www.osti.gov/etdeweb/biblio/5417157},
	abstract = {A new industrial process of Nd-Fe alloy production by the molten salt electrolytic method was introduced. Rare earth metals of Sm and Nd systems for magnetic materials, refining method of metals for magnet materials through the reduction diffusion method, the reduction distillation method, and the molten salt electrolytic method, and various molten salt electrolytic methods were described. By using the apparatus presented in this paper, highly efficient and stable electrolysis was made possible. Electrolysis was conducted adopting NdF \{sub 3\} as an electrolytic feed and adding NdF \{sub 3\} to the LiF-NdF \{sub 3\} system. Stable and continuous electrolysis under the atmospheric condition was made possible by the maximization of current density in the anode. By adopting plate electrodes and three electrodes composed of a central iron cathode and two carbon anodes in both sides, productivity of 7.5 times as high as conventional method was obtained. In the present molten salt electrolysis, current efficiency of 85\%, which was same as electrolytic refining of aluminum, and current density of two times as high as electrolytic refining of aluminum were obtained, and thus, high efficiency of this system was established. 8 refs., 5 figs., 4 tabs.},
	language = {Japanese},
	urldate = {2023-01-30},
	journal = {Denki Kagaku Oyobi Kogyo Butsuri Kagaku (Electrochemistry and Industrial Physical Chemistry); (Japan)},
	author = {Tamamura, H.},
	month = may,
	year = {1991},
	file = {Snapshot:files/4221/5417157.html:text/html},
}

@article{yang_recovery_2020,
	title = {Recovery of rare-earth element from rare-earth permanent magnet waste by electro-refining in molten fluorides},
	volume = {233},
	issn = {1383-5866},
	url = {https://www.sciencedirect.com/science/article/pii/S1383586619314108},
	doi = {10.1016/j.seppur.2019.116030},
	abstract = {Tens of thousands of tons of rare-earth permanent magnet (REPM) wastes are produced worldwide every year. The recovery of rare-earth elements from the wastes can effectively reduce the exploitation of rare-earth minerals. The recovery of neodymium and praseodymium from a REPM waste is investigated by electrolysis in molten LiF-CaF2 where no anode gas releases, making the process environmentally attractive. Neodymium and praseodymium are selectively oxidized from the REPM waste and transformed into rare-earth ions. To facilitate the oxidation of rare-earth elements inside the REPM waste, we intended to make REPM electrode form channels by oxidation of Nd-Pr and Nd2Fe14B alloys. By analyzing the microstructure of REPM electrode after forming channels, it can be found that the channels provide continuous transport access of the electrolyte to the inside of the REPM electrode. The separation rates of Nd and Pr increase with increasing current, while the rate of oxidation reaction is proportional to current. In addition, the oxidation of Fe initially occurs at the inside of the REPM electrode where rare-earth elements have been first depleted. The separated rare-earth ions are directly prepared as rare-earth metals at the cathode by electrolysis, leaving the porous Fe2B alloy and metallic Fe.},
	language = {en},
	urldate = {2023-01-30},
	journal = {Separation and Purification Technology},
	author = {Yang, Yusheng and Lan, Chaoqun and Guo, Lingyun and An, Zhuoqing and Zhao, Zengwu and Li, Baowei},
	month = feb,
	year = {2020},
	keywords = {Separation, Anode channel, Molten fluoride, Rare-earth permanent magnet waste, Recovery},
	pages = {116030},
	file = {ScienceDirect Full Text PDF:files/4222/Yang et al. - 2020 - Recovery of rare-earth element from rare-earth per.pdf:application/pdf;ScienceDirect Snapshot:files/4220/S1383586619314108.html:text/html},
}

@article{yadav_ndfeb_2018,
	title = {{NdFeB} magnet recycling: {Dysprosium} recovery by non-dispersive solvent extraction employing hollow fibre membrane contactor},
	volume = {194},
	issn = {1383-5866},
	shorttitle = {{NdFeB} magnet recycling},
	url = {https://www.sciencedirect.com/science/article/pii/S1383586617325066},
	doi = {10.1016/j.seppur.2017.11.025},
	abstract = {Hollow Fibre Membrane (HFM) operation in non-dispersive solvent extraction (NDSX) mode has been successfully employed for the separation of dysprosium from NdFeB magnetic scrap material using EHEHPA as an extractant. Effect of various hydrodynamic parameters including aqueous phase acidity, extractant concentration, Dy concentration in feed, phase ratio and flow rate were investigated to optimize the condition for quantitative recovery of dysprosium from the leach liquor obtained by the dissolution of hard disk drive (HDD) in nitric acid media. 0.5 M EHEHPA, 0.3 M HNO3 as aqueous feed phase, 100 ml/min flow rate and phase ratio of 1:1 were found to be optimum for both the cycle test runs. Taking the advantage of fast extraction kinetics of dysprosium, two cycle HFM-NDSX approach was adopted to concentrate Dy from 20 to 83\% in first cycle while raising its purity {\textgreater}97\% in the second cycle. The overall process also yielded neodymium rich by-product for its further purification.},
	language = {en},
	urldate = {2023-01-30},
	journal = {Separation and Purification Technology},
	author = {Yadav, Kartikey K. and Anitha, Mallavarapu and Singh, D. K. and Kain, V.},
	month = apr,
	year = {2018},
	keywords = {Recycling, Dysprosium, Hollow fibre membrane, NdFeB magnets},
	pages = {265--271},
	file = {ScienceDirect Full Text PDF:files/4224/Yadav et al. - 2018 - NdFeB magnet recycling Dysprosium recovery by non.pdf:application/pdf;ScienceDirect Snapshot:files/4223/S1383586617325066.html:text/html},
}

@article{islam_process_2022,
	title = {Process {Scale}-{Up} of an {Energy}-{Efficient} {Membrane} {Solvent} {Extraction} {Process} for {Rare} {Earth} {Recycling} from {Electronic} {Wastes}},
	volume = {24},
	issn = {1527-2648},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/adem.202200390},
	doi = {10.1002/adem.202200390},
	abstract = {This study reports the process scale-up and long-term performance of an energy-efficient and cost-effective membrane solvent extraction (MSX) process for separation and recovery of high purity rare earth oxides (REOs) from scrap permanent magnets (SPMs). The rare earth elements (REEs), including dysprosium, neodymium, and praseodymium, are recovered from SPMs using a neutral extractant, tetraoctyl diglycolamide (TODGA) embedded in a microporous polypropylene hollow fiber membrane module. The MSX process performance is demonstrated with bench scale module with membrane surface area of 1.4 m2 to industrial scale modules with membrane surface area of up to 20 m2 to enable the processing of up to 1 ton month−1 of SPMs. The purity and the yield of the recovered REOs are {\textgreater}99.5 wt\% and {\textgreater}95\%, respectively. The average extraction rate of REOs is {\textgreater}10 g m−2 hr−1. A skid of MSX system is assembled with a membrane area of 40 m2. The MSX skid successfully recovers REOs with a capacity of 300 kg REOs/month. Finally, it is determined that the organic phase containing the extractant maintains its performance up to 250 h. The results suggest that the MSX process is an economically viable and environmentally friendly process for separation and recovery of REOs from electronic wastes.},
	language = {en},
	number = {12},
	urldate = {2023-01-30},
	journal = {Advanced Engineering Materials},
	author = {Islam, Syed Z. and Wagh, Priyesh and Jenkins, James Eli and Zarzana, Christopher and Foster, Mac and Bhave, Ramesh},
	year = {2022},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/adem.202200390},
	keywords = {circular economy, membrane solvent extraction, process scale-up, rare earth separations},
	pages = {2200390},
	file = {Full Text PDF:files/4228/Islam et al. - 2022 - Process Scale-Up of an Energy-Efficient Membrane S.pdf:application/pdf;Snapshot:files/4225/adem.html:text/html},
}

@article{niam_simultaneous_2020,
	title = {Simultaneous recovery of rare earth elements from waste permanent magnets ({WPMs}) leach liquor by solvent extraction and hollow fiber supported liquid membrane},
	volume = {148},
	issn = {0255-2701},
	url = {https://www.sciencedirect.com/science/article/pii/S025527011931462X},
	doi = {10.1016/j.cep.2020.107831},
	abstract = {Recovery of rare earth elements (REEs) i.e. neodymium (Nd), dysprosium (Dy), and praseodymium (Pr) from waste permanent magnet (WPMs) leach liquor has been investigated using solvent extraction followed by hollow fiber supported liquid membrane (HFSLM). In the solvent extraction studies, optimum parameters have been obtained for 1 mol/L D2EHPA at pH 2 and 2 mol/L nitric acid for stripping agent. In the HFSLM system, the best percentage achieved at 90 minutes for neodymium, dysprosium, and praseodymium was 58.62 \%, 98.46, and 85.59 \%, as well as for the recovery 63.13 \%, 15.21 \%, and 56.29 \%, respectively. In this study, the optimum transport rate was achieved at 90 minutes, the transport of rare earth’s ion follows the order was Nd {\textgreater} Pr {\textgreater} Dy. The highest transport and permeability coefficient of rare earths ion was achieved by neodymium with values of 0.0083 min−1 (R2{\textgreater}0.94) and 9.34 × 10-8cm s-1, respectively. According to the results, HFSLM system is a promising and feasible technique for the recovery of REEs and separation REEs from iron in WPMs leach liquor. HFSLM system was successfully applied in the lab-scale for the recycling of REEs from industrial waste materials.},
	language = {en},
	urldate = {2023-01-30},
	journal = {Chemical Engineering and Processing - Process Intensification},
	author = {Ni’am, Achmad Chusnun and Wang, Ya-Fen and Chen, Shyh-Wei and Chang, Gen-Mu and You, Sheng-Jie},
	month = feb,
	year = {2020},
	keywords = {Rare earth elements, Recovery, Hollow fiber supported liquid membrane, Solvent extraction},
	pages = {107831},
	file = {ScienceDirect Full Text PDF:files/4229/Ni’am et al. - 2020 - Simultaneous recovery of rare earth elements from .pdf:application/pdf;ScienceDirect Snapshot:files/4227/S025527011931462X.html:text/html},
}

@article{deshmane_selective_2020,
	title = {Selective {Recovery} of {Rare} {Earth} {Elements} from a {Wide} {Range} of {E}-{Waste} and {Process} {Scalability} of {Membrane} {Solvent} {Extraction}},
	volume = {54},
	issn = {0013-936X},
	url = {https://doi.org/10.1021/acs.est.9b05695},
	doi = {10.1021/acs.est.9b05695},
	abstract = {In this study, the scalability of the supported membrane solvent extraction (MSX) process for the recovery of rare earth elements (REEs) from scrap permanent magnets was demonstrated by processing larger quantities of different scrap magnet feedstocks with a membrane area of more than 1 m2. The MSX process was successfully employed to recover high-purity REEs in their oxide form (REOs) from a wide range of end-of-life magnet feedstocks including hard disk drives (HDDs), MRI, cell phone, bonded, swarf, and hybrid car magnets. REEs with the purity of more than 99.5 wt \%, recovery of more than 95\%, and an extraction rate of as high as 9.3 g/(h m2) were recovered from feed solutions containing REEs of up to 46 000 mg/L. It was found that the extraction rate strongly depends on the initial REE concentration in the feed solution and to some extent on the composition of the scrap magnet source. The results demonstrated that MSX is a scalable and versatile process for the recovery of REEs from a wide range of electronic wastes.},
	number = {1},
	urldate = {2023-01-30},
	journal = {Environ. Sci. Technol.},
	publisher = {American Chemical Society},
	author = {Deshmane, Vishwanath G. and Islam, Syed Z. and Bhave, Ramesh R.},
	month = jan,
	year = {2020},
	pages = {550--558},
	file = {ACS Full Text Snapshot:files/4226/acs.est.html:text/html;Full Text PDF:files/4230/Deshmane et al. - 2020 - Selective Recovery of Rare Earth Elements from a W.pdf:application/pdf},
}

@article{baba_selective_2011,
	title = {Selective {Recovery} of {Dysprosium} and {Neodymium} {Ions} by a {Supported} {Liquid} {Membrane} {Based} on {Ionic} {Liquids}},
	volume = {18},
	doi = {10.15261/serdj.18.193},
	abstract = {Selective permeation of rare earth metal ions (Dy and Nd) against ferric ion (Fe) was conducted by an ionic liquid-based supported liquid membrane (SLM).A novel extractant N,N-dioctyldiglycol amic acid (DODGAA) was employed as the mobile carrier because the DODGAA is readily soluble in ionic liquids such as 1-octyl-3-methylimidazolium bis(trifluoromethanesulfonyl)imide ([C8mim][Tf2N]) and shows good selectivity to the rare earth metal ions and efficient stripping behavior. Quantitative transport of Dy and Nd was successfully achieved through the SLM impregnated with the [C8mim][Tf2N] containing DODGAA. Ferric ions were transported at the 10 \% level, and Dy and Nd were selectively recovered to the receiving phase. The results suggested a potential use of the SLM system proposed in this study for the recovery of the rare earth metals from leaching magnet scrap which produces leach liquor containing a large amount of Fe.},
	journal = {Solvent Extraction Research and Development, Japan},
	author = {Baba, Yuzo and Kubota, Fukiko and Kamiya, Noriho and Goto, Masahiro},
	year = {2011},
	pages = {193--198},
	file = {Full Text PDF:files/4232/Baba et al. - 2011 - Selective Recovery of Dysprosium and Neodymium Ion.pdf:application/pdf;J-Stage - Snapshot:files/4231/ja.html:text/html},
}

@article{suzuki_recycling_2001,
	title = {Recycling of {Rare} {Earth} {Magnet} {Scraps}: {Part} {II} {Oxygen} {Removal} by {Calcium}},
	volume = {42},
	shorttitle = {Recycling of {Rare} {Earth} {Magnet} {Scraps}},
	doi = {10.2320/matertrans.42.2492},
	abstract = {Powder scraps of neodymium-iron-boron permanent magnet were deoxidized by using calcium vapor, liquid or CaCl2 melt at 1223–1273 K . Because the scraps react with the acidic solutions during leaching of the byproduct CaO, the methods for removal of the excess amount of Ca and CaO were studied. When pH was controlled at about 8 during several times leaching, the dissolution of rare earth elements could be minimized. Ca vapor deoxidation could not supply enough amount of Ca through CaO layer. When a large amount of CaCl2 was added, the dissolution rate of CaO into the aqueous solution became faster, but some amounts of rare earth components were lost. The deoxidation by Ca liquid and 5 mass\%CaCl2 and the subsequent leaching in distilled water with pH{\textgreater}8 gave the better result so that oxygen, even in heavily oxidized scraps, could be lowered to 0.7 mass\%.},
	number = {12},
	journal = {Materials Transactions},
	author = {Suzuki, Ryosuke O. and Saguchi, Akihiko and Takahashi, Wataru and Yagura, Takashi and Ono, Katsutoshi},
	year = {2001},
	keywords = {calcium deoxidation, calcium halide flux deoxidation, calcium oxide removal, magnet scraps, recycling of magnet, thermodynamics of deoxidation},
	pages = {2492--2498},
	file = {Full Text PDF:files/4234/Suzuki et al. - 2001 - Recycling of Rare Earth Magnet Scraps Part II Oxy.pdf:application/pdf;J-Stage - Snapshot:files/4233/ja.html:text/html},
}

@article{tunsu_reclaiming_2015-1,
	title = {Reclaiming rare earth elements from end-of-life products: {A} review of the perspectives for urban mining using hydrometallurgical unit operations},
	volume = {156},
	issn = {0304-386X},
	shorttitle = {Reclaiming rare earth elements from end-of-life products},
	url = {https://www.sciencedirect.com/science/article/pii/S0304386X15300311},
	doi = {10.1016/j.hydromet.2015.06.007},
	abstract = {Due to their large variety of applications, their low supply and high demand, the rare earth elements (REEs) are presently viewed as being among the most critical chemical elements. Because of this, their potential recovery from end-of-life waste products has been extensively discussed both in society and in the scientific literature. This concept of recovering elements contained in end-of-life products, known as urban mining, is regarded as an important step in achieving a sustainable, circular society. This review article discusses the perspectives of reclaiming the REEs from various waste streams using hydrometallurgical methods. Three main streams are discussed in detail (phosphor-containing products, NiMH batteries and permanent magnets), touching on the state-of-the-art of material pre-treatment, leaching and separation of REEs and refining. Comparisons with the extraction of REEs from ores are drawn, bringing forth both the advantages and some of the disadvantages of urban mining.},
	language = {en},
	urldate = {2023-01-30},
	journal = {Hydrometallurgy},
