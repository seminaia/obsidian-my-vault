@article{elizabeth_electric_1945,
	title = {Electric {Conductivity} of {Molten} {Chloride} {Salts}},
	abstract = {The electric conductivity of mixed molten chloride salts as used in magnesium electrolysis cells was determined at various temperatures, using a fused quartz cell in a capacity‐compensated Wheatstone bridge circuit supplied with approximately 1,000 cycle alternating current. The four‐component system , , ,  at the 20\%  level was extensively studied. Part of the same system at the 9\%  level was studied. The conductivity of each of the four pure components was determined. The conductivity of the molten chloride salts increases linearly with rise of temperature. Increasing the magnesium chloride content of a typical melt from 9\%, to 20\% results in a slight lowering of the conductivity. Low conductivities were measured in mixtures high in potassium chloride or high in potassium chloride and calcium chloride. High conductivities were found in mixtures containing large amounts of sodium chloride or in mixtures containing little or no potassium chloride but large amounts of calcium chloride},
	journal = {The Electrochemical Society},
	author = {Elizabeth, .Lee},
	year = {1945},
	file = {Lee_1945_Trans._Electrochem._Soc._88_171.pdf:files/5488/Lee_1945_Trans._Electrochem._Soc._88_171.pdf:application/pdf},
}

@article{vardar_electrochemistry_2014,
	title = {Electrochemistry of {Magnesium} {Electrolytes} in {Ionic} {Liquids} for {Secondary} {Batteries}},
	volume = {6},
	issn = {1944-8244},
	url = {https://doi.org/10.1021/am5049064},
	doi = {10.1021/am5049064},
	abstract = {The electrochemistry of Mg salts in room-temperature ionic liquids (ILs) was studied using plating/stripping voltammetry to assess the viability of IL solvents for applications in secondary Mg batteries. Borohydride (BH4–), trifluoromethanesulfonate (TfO–), and bis(trifluoromethanesulfonyl)imide (Tf2N–) salts of Mg were investigated. Three ILs were considered: l-n-butyl-3-methylimidazolium (BMIM)-Tf2N, N-methyl-N-propylpiperidinium (PP13)-Tf2N, and N,N-diethyl-N-methyl(2-methoxyethyl)ammonium (DEME+) tetrafluoroborate (BF4–). Salts and ILs were combined to produce binary solutions in which the anions were structurally similar or identical, if possible. Contrary to some prior reports, no salt/IL combination appeared to facilitate reversible Mg plating. In solutions containing BMIM+, oxidative activity near 0.8 V vs Mg/Mg2+ is likely associated with the BMIM cation, rather than Mg stripping. The absence of voltammetric signatures of Mg plating from ILs with Tf2N– and BF4– suggests that strong Mg/anion Coulombic attraction inhibits electrodeposition. Cosolvent additions to Mg(Tf2N)2/PP13-Tf2N were explored but did not result in enhanced plating/stripping activity. The results highlight the need for IL solvents or cosolvent systems that promote Mg2+ dissociation.},
	number = {20},
	urldate = {2020-09-17},
	journal = {ACS Appl. Mater. Interfaces},
	author = {Vardar, Gulin and Sleightholme, Alice E. S. and Naruse, Junichi and Hiramatsu, Hidehiko and Siegel, Donald J. and Monroe, Charles W.},
	month = oct,
	year = {2014},
	pages = {18033--18039},
	file = {Vardar et al. - 2014 - Electrochemistry of Magnesium Electrolytes in Ioni.pdf:files/4818/Vardar et al. - 2014 - Electrochemistry of Magnesium Electrolytes in Ioni.pdf:application/pdf;Vardar et al. - 2014 - Electrochemistry of Magnesium Electrolytes in Ioni.pdf:files/5396/Vardar et al. - 2014 - Electrochemistry of Magnesium Electrolytes in Ioni.pdf:application/pdf},
}

