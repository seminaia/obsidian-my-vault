@article{perkins_fundamental_nodate,
	title = {Fundamental {Geochemical} {Processes} {Between} {CO2}, {Water} and {Minerals}},
	abstract = {The generic geochemical effects of adding CO2 to water, to water and solids (with carbonate minerals) and to water and solids with exchangeable surface sites has been calculated and reviewed below. Although the reaction details are clearly a function of the fluid composition, the partial pressure of the CO2 being added, the mineralogy and the cation exchange capacity, some generic conclusions can be reacted. The atmosphere controls the final dissolved CO2 levels and brings them back to very near original values – effectively, there is little or no carbon storage in the fluid. There is no carbon storage by precipitation of carbonate minerals in “short term processes – this process is driven by the dissolution of silicate minerals which react much more slowly. If carbonate minerals were present in the original mineralogy, some portion will dissolve (when CO2 is added). This may result in additional CO2 being released to the atmosphere.},
	language = {en},
	author = {Perkins, Ernie},
	pages = {9},
	annote = {Ions from dissolved CO2 mostly carbonic acid H2CO3, bicarbonate ions HCO3(-), and carbonate ions CO3(2-)
Increasing CO2 pressure increases fluid CO2 solubility, but increasing T past {\textasciitilde}65 degrees C (at {\textasciitilde}30 MPa or less) decreases CO2 solubility in the fluid
Decreasing CO2 pressure allows CO2 to evolve from fluid, which makes fluid more alkaline (fluid becomes more acidic if CO2 is dissolved into fluid, which can result in precipitation of solids, mostly carbonate minerals)
If calcite is present in fluid, it dissolves and allows slightly more CO2 absorption},
	file = {Perkins - Fundamental Geochemical Processes Between CO2, Wat.pdf:files/5598/Perkins - Fundamental Geochemical Processes Between CO2, Wat.pdf:application/pdf},
}

