@book{nazarov_chromatographic_1981,
	address = {Japan},
	title = {Chromatographic separation of transuranium elements, rare earth elements and alkali earth elements},
	abstract = {Complex salt-forming displacement chromatography is one of the promising methods for
producing radioactive rare earth elements, alkali earth elements and transuranium
elements of high chemical and radiochemical purities in large quantities While the
method is widely used for chemical refining, the choosing of separation conditions
is made empirically in many cases Therefore, the need of the calculation method for
the optimal conditions of chromatographic separation processes arose Presently, the
prerequisites are available for the theoretical calculation of the elution processes
of three kinds of elements As the complexing agents, the solutions of nitrilotriacetic
acid (NTA), diethylenetriaminepentaacetic acid (DTPA) and ethylenediaminetetraacetic
acid (EDTA), which have been most widely employed in chromatographic separation, were
used Both the displacement chromatography developed and the calculation method for
the high purity separation of fission fragment elements (147Pm, 90Sr) and transplutonium
elements (sup(241,243)Am, sup(242,244)Cm) are useful and promising (JPN)},
	publisher = {Japan Atomic Industrial Forum, Inc},
	author = {Nazarov, P.P.},
	year = {1981},
