@techreport{noauthor_report_2014,
	title = {Report on {Critical} {Raw} {Materials} for the {EU}},
	url = {http://ec.europa.eu/DocsRoom/documents/10010/attachments/1/translations},
	abstract = {Although raw materials are essential for the EU economy, growth and jobs their availability is increasingly under pressure. Within the framework of the EU Raw Materials Initiative, it was decided to assess a number of raw materials at least every three years with a view to establish a list of raw materials at EU level that are deemed critical. In June 2010 the Commission published its first expert report, which established a methodology for the identification of critical raw materials. The report has put forward a list of fourteen critical raw materials. In its 2011 Communication the Commission formally adopted this list and proposed that it will monitor the issues of critical raw materials to identify priority actions, examine them with Members States and stakeholders and regularly update the list of critical raw materials. The present report further builds upon the work undertaken in the 2010 report. It should be noted that in the current report the same methodology has been used as in the 2010 in order to ensure comparability between the two lists. The purpose of this present report is to revise and extend the work carried out in the previous report, taking into consideration feedback gathered from the previous exercise, and in doing so produce an updated list of critical raw materials for the EU.},
	language = {en},
	number = {52014DC0297},
	institution = {Ad Hoc Working Group on defining critical raw materials},
	month = may,
	year = {2014},
	file = {crm-report-on-critical-raw-materials_en.pdf:files/5839/crm-report-on-critical-raw-materials_en.pdf:application/pdf},
}

