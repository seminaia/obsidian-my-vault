@article{ku_impact_2015,
	title = {Impact of {Light} {Emitting} {Diode} {Adoption} on {Rare} {Earth} {Element} {Use} in {Lighting}: {Implications} for {Yttrium}, {Europium}, and {Terbium} {Demand}},
	volume = {24},
	issn = {1944-8783},
	shorttitle = {Impact of {Light} {Emitting} {Diode} {Adoption} on {Rare} {Earth} {Element} {Use} in {Lighting}},
	url = {https://iopscience.iop.org/article/10.1149/2.F04154if},
	doi = {10.1149/2.F04154if},
	abstract = {Light emitting diode (LED) lamps use significantly less rare earth elements per lumen of light generated than their fluorescent lamp counterparts. As a result, the global demand for rare earth oxides used in lighting will eventually peak and decline, as the market share of LED lighting increases. The exact timing of this inflection point is dependent on a number of factors, including market growth rates, regional LED adoption rates, and the relative costs of LED and fluorescent lighting technology. Lighting market forecasts from the U.S. Department of Energy were used to estimate the timing of the inflection point for the United States. Domestic rare earth demand can peak as early as 2019. A similar dynamic is expected globally, with timing sensitive to the local LED adoption rate. The analysis did not account for the potential effects of new technologies that use rare earth elements or possible variations in growth rates due to the economic cycle.},
	language = {en},
	number = {4},
	urldate = {2022-02-03},
	journal = {Electrochemical Society Interface},
	author = {Ku, Anthony and Setlur, Anant A. and Loudis, Jonathan},
	month = jan,
	year = {2015},
	pages = {45},
	file = {2015 - Impact of Light Emitting Diode Adoption on Rare Ea.pdf:files/4630/2015 - Impact of Light Emitting Diode Adoption on Rare Ea.pdf:application/pdf},
}

