	file = {McGonigal et al. - 1962 - The Liquid Temperature Range, Density, and Critica.pdf:files/5659/McGonigal et al. - 1962 - The Liquid Temperature Range, Density, and Critica.pdf:application/pdf},
}

@article{vatalis_market_2015,
