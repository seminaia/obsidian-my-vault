	journal = {ECS Trans.},
	author = {Drenckhahn, Wolfgang W and Greiner, Horst and Kühne, Michael and Landes, Harald and Leonide, Andre and Litzinger, Kevin and Lu, C. and Schuh, Carsten and Shull, Jim and Soller, Thomas},
