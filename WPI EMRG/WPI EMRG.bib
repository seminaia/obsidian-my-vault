	pages = {161--173},
	annote = {MgO*Na2CO3*NaNO3 mesoporous composites for CO2 capture, 250 to 450 degrees C; water greatly enhances adsorption},
	file = {Vu et al. - 2016 - Double sodium salt-promoted mesoporous MgO sorbent.pdf:files/5737/Vu et al. - 2016 - Double sodium salt-promoted mesoporous MgO sorbent.pdf:application/pdf},
}

