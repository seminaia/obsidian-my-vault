	url = {https://doi.org/10.1007/s10668-022-02663-2},
	doi = {10.1007/s10668-022-02663-2},
	abstract = {Existing desalination technologies produce large amount of waste brines with higher salinity concentration than feed seawater, the disposal of which pose serious environmental problems. At the same time, waste brines represent a valuable source of strategic materials—such as magnesium—and therefore their valorization offers the opportunity to overtake both the environmental and the economic issues. Current needs are to identify gaps and challenges to recover secondary magnesium in order to bring recovery technologies closer to the market for potential commercial applications. In this technical review, the available methods for magnesium recovery from seawater desalination brines are described and compared in details, to provide the readers with a wide overview to better address their research efforts towards resources valorization, in accordance with the circular economy principles.},
	language = {en},
	number = {12},
	urldate = {2023-11-06},
