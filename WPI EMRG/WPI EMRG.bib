	title = {Justice in energy transitions},
	volume = {31},
	issn = {22104224},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2210422418301588},
	doi = {10.1016/j.eist.2018.12.001},
	abstract = {This paper argues that transitions research more broadly needs to take more account of justice in its analysis. This paper draws primarily from environmental and energy justice literature to engage with the concept of justice in transitions research, as it seeks justice for people, communities, and the non-human environment from negative environmental impacts. This is achieved through different forms of justice: distributive, procedural, and recognition. Our paper concludes with reflections upon the application of a justice approach to sustainability transitions research and offer insights into a potentially new research agenda.},
