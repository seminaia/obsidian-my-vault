@article{fang_hydrogen_nodate,
	title = {Hydrogen assisted magnesiothermic reduction ({HAMR}) of {TiO2} to produce titanium metal powder},
	abstract = {The high cost of titanium products in end applications is related to the
attributes of the Kroll process, namely the cost of reducing agent Mg, long
process time, batch-type processing, and high-energy consumption, as well as the machining of wrought products to final configurations. Substantial savings are possible by using a combination of improved
extraction processes and powder metallurgy. There are many developing processes, such as the FFC, Armstrong (ITP), TiRO, CSIR-Ti, and the DRTS process (which later evolved to become the HAMR process), which all attempt to replace the Kroll process. Most of these new methods produce Ti primary metal in the form of powder which can be used in powder metallurgy processes.},
	author = {Fang, Zhigang Zak and Xia, Yang and Lefler, Hyrum and Zhang, Yiang and Sun, Pei},
