	year = {2018},
	pages = {407--459},
	file = {Fang et al. - 2018 - Powder metallurgy of titanium – past, present, and.pdf:files/3819/Fang et al. - 2018 - Powder metallurgy of titanium – past, present, and.pdf:application/pdf},
}

