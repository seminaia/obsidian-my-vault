@misc{schulz_worldwide_2019,
	title = {Worldwide {CO}₂ {Emissions} (2016; by region; per capita)},
	copyright = {CC-SA 4.0 Int'l},
	url = {https://en.wikipedia.org/wiki/File:2018_AQAL_Group_variwide_chart_%22Worldwide_Co2_emissions%22.jpg},
	abstract = {Tom Schulz developed the variwide chart "Worldwide CO₂ Emissions". The total CO₂ emissions of a region is represented through a rectangular area. The height of each rectangle is proportional to the CO₂ emissions per capita and the width is proportional to the population of the represented region. The regions are sorted by CO₂ emissions per capita, from the highest to the lowest. The data comes from the International Energy Agency, was published in 2018 and shows the 2016 status. It becomes obvious that emissions vary widely from one country to the next with 30.8 t per capita in Qatar to 16.2 t per capita in the U.S., 6.6 t per capita in China, all the way down to Africa with 0.95 t per capita. The world average is 4.35 t per capita. Most industrialized nations range between 4 t and 15 t CO₂ emissions per capita. Through this chart, it becomes obvious that the earth would not be able to absorb additional CO₂ emissions to make room for additional developing nations like India and continents like Africa to “catch up” by increasing their per capita emissions to the current average. Never mind that developed countries are to be made responsible for the current misery, the fate of the earth is currently decided by what occurs in China, India, Africa and other developing countries from now on.},
	language = {en},
	urldate = {2020-01-03},
	author = {Schulz, Tom},
	month = feb,
	year = {2019},
	file = {2018_AQAL_Group_variwide_chart_Worldwide_Co2_emissions.jpg:files/5906/2018_AQAL_Group_variwide_chart_Worldwide_Co2_emissions.jpg:image/jpeg},
}

@misc{wilcox_cost_nodate,
	title = {Cost {Scenarios} of {Carbon} {Capture} and {Storage} from {U}.{S}. {Natural} {Gas}-fired {Power} {Plants}},
	abstract = {Existing solvent-based technology has been applied to point-source emissions associated with the power sector associated with natural gas combustion. Cumulative costs of 90\% CO₂ capture to 98\%+ purity, combined with compression, transport and injection have been evaluated and compared for applications to permanent CO₂ storage via CO₂-EOR or geologic storage in light of today’s Federal tax credit, 45Q. Both trucking and pipeline modeling were considered, with pipeline transport always being economic due to the large scales of CO₂ transport, and particular, mostly economic in the regions of existing CO₂ pipelines, namely the Permian Basin and Gulf Coast. In light of 45Q, a gap remains toward incentivizing the permanent storage of CO₂. In particular, the average costs from separation to injection for geologic storage of CO₂ are \$144/tCO₂ and \$165/tCO₂ for pipeline and trucking transportation, respectively, with low-end opportunities of \$100/tCO₂ for both cases. In terms of CO₂-EOR, the average costs from separation to injection are \$169/tCO₂ and \$253/tCO₂ for pipeline and trucking transportation, respectively, with low-end opportunities of \$112/tCO₂ and \$140/tCO₂, respectively. The inclusion of 45Q was considered when streams were large enough to meet the qualifying limits (i.e., {\textgreater} 500 ktCO₂/yr). In all cases considered, the federal tax credit was not sufficient to close the gaps even in the case of CO₂ prices for EOR reaching \$40/tCO₂. Advancing the scale of CCS will require both technological advances in the capture technology, combined with increased policy incentives, in terms of cost along with reduction of qualifying limits, in order to maximize impacts.},
	author = {Wilcox, Jennifer and Psarras, Peter and He, Jiajun and Pilorgé, Hélène and McQueen, Noah and Jensen-Fellows, Alexander},
	file = {Natural-Gas-Study_Wilcox.pdf:files/5907/Natural-Gas-Study_Wilcox.pdf:application/pdf},
}

