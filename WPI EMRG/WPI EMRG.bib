	pages = {100--116},
	file = {Kang et al. - 2012 - Thermodynamic evaluations and optimizations of bin.pdf:files/4783/Kang et al. - 2012 - Thermodynamic evaluations and optimizations of bin.pdf:application/pdf},
}

