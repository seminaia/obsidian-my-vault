@phdthesis{olausson_life_1999,
	address = {Lund, Sweden},
	type = {Master of {Science}},
	title = {Life {Cycle} {Assessment} of an {SOFC}/{GT} {Process}},
	url = {https://www.osti.gov/etdeweb/servlets/purl/10154556},
	abstract = {For the last few years much effort has been put into the research on different kinds of fuel cells, since these are considered to be both an efficient and environment friendly way to convert energy. The fuel cell studied here is the solid oxide fuel cell (SOFC) that works at a high temperature (800-1000 °C) and today achieves a stand-alone electric efficiency of approximately 50\% (LHV). Because of the high temperature after the energy conversion in the fuel cell, the excess heat can be used for electricity generation by afterburning and expansion of the exhaust gases leaving the SOFC in a gas turbine. When integrating the SOFC in a gas turbine process (SOFC/GT process) an efficiency of 70-75\% can be reached. Many developers claim that the SOFC and the SOFC/GT process are environment friendly regarding the discharges. Especially formation of nitrogen oxides (NOx) is low since the SOFC temperatures are low compared to NOx formation temperatures.

To study the whole environmental impact of the SOFC/GT process a life cycle assessment (LCA) is carried out to find the "hot spots” in the process’ life cycle. Since the SOFC/GT process is under development today the collected data are mainly from literature and articles based on laboratory results. When performing the LCA only the SOFC-module and the gas turbine are included. Short descriptions ofthe components; pre-reformer and desulphurization system are also included to get a comprehensive view ofthe process.

The collected data of all processes included, extraction of minerals, processing of raw material, production of the components, operation of the SOFC/GT process and transports between all these processes, are added up and weighted in impact categories to evaluate the total environmental impact of the SOFC/GT process. All these steps are performed according to the ISO 14 040-series.

The stand-alone most contributing phase during the life cycle of the SOFC/GT process was found to be the production of the SOFC. The pyrolysis process of the required raw materials and the sintering of the sub components of the SOFC require an extended amount of energy. Of course both these processes are carried out under laboratory circumstances, but even when halving the use of energy this phase is much more dominant than for other processes assessed at Sydkraft. Much effort must be put into this phase, which Risoe does, for the SOFC/GT process to be competitive with other energy converting processes regarding the discharges of emissions to the air.

When the SOFC/GT process is considered as waste the turbine and the fuel process components (pre-reformer and desulphurization system) can be recycled but the SOFC is hard to split up in its sub components again. Even the waste obtained during the production of each sub component can not be recycled today and are just placed at landfills. A sophisticated waste management system ought to be developed and effort put into recycling of the SOFC.},
	language = {en},
	urldate = {2023-06-09},
	school = {Lund Royal Institute of Technology},
	author = {Olausson, Pernilla},
	month = jun,
	year = {1999},
	file = {10154556.pdf:files/3955/10154556.pdf:application/pdf},
}

