@patent{_method_nodate,
	title = {Method for separating nickel and iron from nickel-iron alloy},
	url = {https://patents.google.com/patent/CN112626356A/en},
	abstract = {The invention discloses a method for separating nickel and iron from a nickel-iron alloy, which comprises the following steps: (1) controlling the granularity of the nickel-iron alloy to be treated to be 5-20 mm; (2) adding a nickel-iron alloy and metal magnesium into a graphite crucible, placing the graphite crucible into a heating furnace, heating the graphite crucible to 750-880 ℃ in an inert atmosphere, and preserving heat for 2-5 h; (3) continuously raising the temperature to 900-1200 ℃, simultaneously vacuumizing to realize vacuum distillation of the magnesium melt in a boiling state, and preserving the temperature for 5-10 hours; (4) and after the distillation is finished, cooling the materials to room temperature, and winnowing to obtain the separated flaky metallic nickel and the separated porous metallic iron alloy. The invention skillfully utilizes the property that the granularity of the residual metallic iron after distillation inherits the granularity of the initial ferronickel alloy, and controls the granularity of the ferronickel alloy to be within the range of 5-20mm, so that the granularity of the residual metallic iron is also within the range, and the nickel formed after distillation is flaky, therefore, the residual metallic iron and the nickel are extremely easy to realize separation and separation.},
