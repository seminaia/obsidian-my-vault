@article{hibino_solid_2021,
	title = {Solid {Oxide} {Fuel} {Cell} {Using} {Municipal} {Solid} {Waste} {Directly} as {Fuel}: {Biomass}, {Resin}, {Plastic}, and {Food} {Waste}},
	volume = {9},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0/},
	issn = {2168-0485, 2168-0485},
	shorttitle = {Solid {Oxide} {Fuel} {Cell} {Using} {Municipal} {Solid} {Waste} {Directly} as {Fuel}},
	url = {https://pubs.acs.org/doi/10.1021/acssuschemeng.0c07657},
	doi = {10.1021/acssuschemeng.0c07657},
	abstract = {Municipal solid waste has received signiﬁcant attention in advanced waste treatment engineering. A recent trend emphasizing its signiﬁcance is the utilization of waste as an energy source with high eﬃciency and low cost. This report describes a waste-to-energy fuel cell that uses biomass, resin, plastic, and food waste directly as fuels at a temperature of 800 °C. A Fe2O3 anode demonstrated the best catalytic eﬀect for the anode reaction among various investigated transition-metal oxides. Fe2O3 was reduced to FeO by pyrolysis gases or solid fuel at the opencircuit voltage and was then gradually reoxidized to its initial oxidation state by anodic polarization. The gasiﬁcation reaction of carbon with carbon dioxide, i.e., the Boudouard reaction, was substantially catalyzed during discharge of the cell. Cell performance was dependent on the quantity and type of solid fuel: polyethylene terephthalate provided the highest power density of 0.57 W cm−2, whereas lignin presented the highest energy density of 0.83 Wh g−1 (lignin). Two distinctive features of this fuel cell are that the organic components of the solid fuels are almost completely consumed by discharge of the cell and that solid fuels can be supplied in both batch and free-fall modes.},
	language = {en},
	number = {8},
	urldate = {2025-01-10},
	journal = {ACS Sustainable Chem. Eng.},
	author = {Hibino, Takashi and Kobayashi, Kazuyo and Teranishi, Shinya and Hitomi, Takuma},
	month = mar,
	year = {2021},
	pages = {3124--3136},
	file = {Hibino et al. - 2021 - Solid Oxide Fuel Cell Using Municipal Solid Waste .pdf:files/3543/Hibino et al. - 2021 - Solid Oxide Fuel Cell Using Municipal Solid Waste .pdf:application/pdf},
}

