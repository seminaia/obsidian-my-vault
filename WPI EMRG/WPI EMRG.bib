	month = jan,
	year = {2021},
	note = {Number: 14},
	keywords = {cost of heat and electricity, portable micro-reactors},
	pages = {4385},
	file = {Full Text PDF:files/4805/Buongiorno et al. - 2021 - Can Nuclear Batteries Be Economically Competitive .pdf:application/pdf;Snapshot:files/4804/4385.html:text/html},
}

