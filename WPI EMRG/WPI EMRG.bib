	file = {Gorsse et al. - 2005 - A thermodynamic assessment of the Mg–Nd binary sys.pdf:files/4571/Gorsse et al. - 2005 - A thermodynamic assessment of the Mg–Nd binary sys.pdf:application/pdf},
}

