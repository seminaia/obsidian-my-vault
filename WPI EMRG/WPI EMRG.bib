	title = {Design of a {Molten} {Salt} {Magnesium} {Air} {Battery} for {Shipping} and {Other} {Applications}},
	abstract = {The large scale burning of fuel oils in transoceanic shipping makes up 3 \% of global greenhouse gas emissions, sparking opportunities for energy-dense renewables to power the industry. This MQP focused on refining the experimental design of magnesium-air battery cells, achieving peak open-circuit voltage of 1.53 𝑉. Manufacturing of cathode tubes was improved, bypassing welding to cut lead time in half. Air leakage was subsequently minimized, replacing pneumatic systems followed by safety overhauls to ensure thermal and electrical insulation. HCl off-gas was contained within bubbler tubes, and new procedures for setup, operation, and cooldown were documented through diagrams and tutorial videos. The team developed models for reaction kinetics (FactSage), fluid and heat transfer (COMSOL), and industry comparison metrics (Excel). Based on these models, new design changes were proposed that leverage fluoride salts, alloyed magnesium, electrolyte stirring, and air preheating.},
	institution = {Worcester Polytechnic Institute},
	author = {Giles, Dante T. and McGowan, Seth and Murdock, Matthew and Sullivan, Zachary},
	month = apr,
	year = {2026},
