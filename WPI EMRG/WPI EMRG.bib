	urldate = {2021-01-19},
	journal = {J. Chem. Eng. Data},
	author = {Kubíková, Blanka and Boča, Miroslav and Mlynáriková, Jarmila and Gurišová, Veronika and Šimurda, Michal and Netriová, Zuzana and Korenko, Michal},
