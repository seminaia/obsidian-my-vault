@article{roth_particle_2007,
	title = {Particle synthesis in flames},
	volume = {31},
	issn = {1540-7489},
	url = {http://www.sciencedirect.com/science/article/pii/S1540748906003816},
	doi = {10.1016/j.proci.2006.08.118},
	abstract = {From the view point of combustion science, the fundamentals of particle formation in a flame environment are discussed. The principles of converting a gas phase precursor dopant into particles and also their growth are addressed. Various experimental methods and examples for the synthesis of particles of both single and mixed oxides are reviewed. First attempts to tune the stoichiometry of oxide particles by varying the combustion parameters of premixed flames are demonstrated. Some aspects of modelling and the problems which still need to be solved are illustrated by means of the particles’ population balance equation.},
	language = {en},
	number = {2},
	urldate = {2020-03-27},
	journal = {Proceedings of the Combustion Institute},
	author = {Roth, Paul},
	month = jan,
	year = {2007},
	keywords = {Nanoparticles},
	pages = {1773--1788},
	annote = {Temperature controls precursor decomposition, monomer formation, cluster kinetics, and early particle formation; therefore influences large, structured agglomerations
Precursor concentration increase = primary particle size increase
Temperature increase = smaller primary particles (more precursor decomposition, monomer formation, high coalescence rate)
High temperature, short residence times = compact particles
Low temperature, long residence times = highly structured agglomerates
Both primary particle size and particles per agglomeration level out over time},
	file = {ScienceDirect Full Text PDF:files/5708/Roth - 2007 - Particle synthesis in flames.pdf:application/pdf;ScienceDirect Snapshot:files/5709/S1540748906003816.html:text/html},
}

@article{fennell_sampling_2007,
	title = {The sampling of nanoparticles of {MgO} formed when doping an oxygen-rich flame with magnesium: {The} measurement of the concentrations and size-distributions of these nanoparticles},
	volume = {151},
	issn = {0010-2180},
	shorttitle = {The sampling of nanoparticles of {MgO} formed when doping an oxygen-rich flame with magnesium},
	url = {http://www.sciencedirect.com/science/article/pii/S0010218007001939},
	doi = {10.1016/j.combustflame.2007.07.004},
	abstract = {A technique for measuring the concentrations and size-distributions of nanoparticles of the oxide of Mg (and similar elements with involatile oxides), when an oxygen-rich flame is doped with an appropriate metal is considered in detail. For this purpose a well-characterized, premixed, laminar flat flame of C2H2+O2+N2 was burnt fuel-lean at 1 atm; the final steady temperature in the burned gas was 2000±30 K. An aqueous solution of, e.g., MgCl2 was nebulized as a fine spray into the unburned gas fed to the burner, so that the total concentration of Mg atoms in the flame was finally ∼13 p.p.m. A very pale white turbidity indicated that particles (in fact of MgO) form very quickly in the flame's reaction zone. The technique involved sampling the flame through a hole at the tip of a conical quartz probe. The sample was supersonically expanded to a lower pressure and then diluted; some of the resulting gas was passed into a particle sizer, which measured the concentrations and sizes of the particles from their differential mobilities. This study reports particle size distributions (PSDs) and number densities as measured for different sizes of the sampling orifice, for different dilutions of the sample, and for various pressures inside the probe. In general, it was found that a PSD can be falsified by nanoparticles agglomerating in the sampling line. Such falsification of the measurements can be minimized by(i)Ensuring that the sample of flame gas is diluted as quickly as possible with a large flow of particle-free nitrogen. However, care has to be taken to avoid turbulence in the probe and sampling lines, as well as the consequential deposition of nanoparticles on the walls.(ii)Maintaining a low pressure ({\textless}0.5 bar) inside the sampling probe and lines, so that the flow through the sampling orifice is choked and also the collision frequency is low enough for there to be no agglomeration of particles. To achieve a rapid reduction in pressure with minimal disturbance of the flame, a conical probe is desirable.(iii)Sampling a flame through an orifice wider than 0.3 mm to ensure that only a small fraction of the MgO particles are deposited on the quartz around the sampling hole.(iv)Reducing the deposition of particles inside the probe by using cooling water at 90 °C. If these guidelines are followed, the sampling of nanoparticles becomes quantitative, in that to within ±40\% every particle of MgO entering the sampling system is detected.},
	language = {en},
	number = {4},
	urldate = {2020-05-19},
	journal = {Combustion and Flame},
	author = {Fennell, P. S. and Dennis, J. S. and Hayhurst, A. N.},
	month = dec,
	year = {2007},
	keywords = {Nanoparticles, Aerosols, Inorganic soots, Probes, Solid propellants},
	pages = {560--572},
	annote = {Lower-temperature furnace experiments (vs. flame), higher precursor concentrations lead to better Pb scavenging by silica sorbent (higher particle formation rates)
Silicon composite networks made good sorbent clusters with high surface areas},
	file = {ScienceDirect Full Text PDF:files/5711/Fennell et al. - 2007 - The sampling of nanoparticles of MgO formed when d.pdf:application/pdf;ScienceDirect Snapshot:files/5710/S0010218007001939.html:text/html},
}

