	abstract = {The blank of thermodynamic properties in the CaO-Al₂O₃-Ce₂O₃ basic slag system limits the application of rare earth element in relevant materials. In the current work, H, Cp (298 K), and Cp (T) of ternary oxide minerals were estimated using the split-combination method, Neumann–Kopp rule, and Kubaschewski method, respectively. Then, a thermodynamic model for calculating the activity of oxides in the CaO-Al₂O₃-Ce₂O₃ system, i.e., the IMCT-ai model, has been developed based on IMCT and by introducing the correction coefficient Fi according to the phase diagram theory. And the relationship between the correction coefficient and the compositions was established. Compared with the IMCT model, the good agreement between the calculated activity by the IMCT-ai model and the reported activity indicated that the IMCT-ai model can be applied to predict the activity of the CaO-Al2O3-Ce2O3 system. Furthermore, iso-activity curves of oxides in the CaO-Al2O3-Ce2O3 ternary systems were estimated at 1500 °C, 1550 °C, and 1600 °C, respectively.},
	language = {en},
	number = {5},
	urldate = {2026-09-30},
	journal = {Metall Mater Trans B},
	author = {Zheng, Xiang and Liu, Chengjun},
	month = oct,
	year = {2021},
	pages = {3183--3192},
	file = {Zheng and Liu - 2021 - Thermodynamic Properties Assessment of CaO-Al2O3-C.pdf:files/6502/Zheng and Liu - 2021 - Thermodynamic Properties Assessment of CaO-Al2O3-C.pdf:application/pdf},
}

@article{li_phase_2017,
	title = {Phase diagram assessment of {CaO}–{Al}$_{\textrm{2}}${O}$_{\textrm{3}}$–{La}$_{\textrm{2}}${O}$_{\textrm{3}}$ system},
	volume = {56},
	issn = {0008-4433, 1879-1395},
	url = {https://www.tandfonline.com/doi/full/10.1080/00084433.2017.1327473},
	doi = {10.1080/00084433.2017.1327473},
	abstract = {Considering the significance of CaO–Al₂O₃–RE₂O₃ (RE = rare earth) phase diagrams, the Redlich–Kister expression was employed to evaluate the binary phase diagrams of CaO–Al₂O₃, La₂O₃–Al₂O₃ and CaO–La₂O₃ systems in the present work. Also, the activities of CaO and Al₂O₃ in the CaO–Al₂O₃ binary system were calculated. The phase diagram of the CaO–Al₂O₃–La₂O₃ ternary system was first assessed by Kohler extrapolation method. The accuracy of calculated phase diagrams was validated by comparing with existing experimental points and the calculation results from the literature. The obtained diagrams will lay a foundation for Al-killed steelmaking process, metallurgical flux and other fields’ industrial application.},
	language = {en},
	number = {3},
	urldate = {2026-09-30},
	journal = {Canadian Metallurgical Quarterly},
	author = {Li, Yandong and Liu, Chengjun and Zhang, Tongsheng and Tian, Meizi and Peng, Cheng},
	month = jul,
	year = {2017},
	pages = {245--251},
	file = {Li et al. - 2017 - Phase diagram assessment of CaO–Al2Osu.pdf:files/6503/Li et al. - 2017 - Phase diagram assessment of CaO–Al2Osu.pdf:application/pdf},
}

@article{pandhare_highly_2026,
	title = {Highly efficient electrolysis platform for quasi-continuous high-purity iron production},
	issn = {30512948},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S3051294826001635},
	doi = {10.1016/j.checir.2026.100167},
	abstract = {Low-temperature electrolysis using alkaline solutions offers sustainable iron production from copper dust waste, but conventional cells are limited by batch operation. Aided by simulations, we designed an electrolytic cell with a rotating cathode, enabling quasi-continuous Fe production without disassembly. Over four cycles, the system achieved {\textgreater}95 wt \% iron purity and {\textgreater}91\% current efficiency. Techno-economic analysis estimated the production cost of hot-rolled coil (HRC) at approximately \$864/MT at market electricity prices and current technology levels, including feedstock credit, with potential costs of \$545–723/MT using lower-cost elec­ tricity, feedstock credit, and extended cathode lifetime. Greenhouse gas emissions were estimated at 1,660 kg CO2e/MT HRC with grid electricity and 250 kg CO2e/MT HRC with nuclear electricity, representing 36\% and 90\% reductions, respectively, compared with blast furnace-basic oxygen furnace (BF-BOF). The de­ signed cell demonstrates potential for industrial-scale iron production through low-temperature electrolysis.},
	language = {en},
	urldate = {2026-10-21},
	journal = {Chem Circularity},
	author = {Pandhare, Atharva and Thanwisai, Panya and Zhou, Hao and Mahdavi, Omid and Ganguly, Arna and Zhou, Rufan and Hou, Jiahui and Yao, Zeyi and Wang, Zexin and Meng, Zifei and Lee, Kyuha and Sun, Pingping and Mishra, Brajendra and Powell, Adam and Wang, Yan},
	month = oct,
	year = {2026},
	pages = {100167},
	file = {Pandhare et al. - 2026 - Highly efficient electrolysis platform for quasi-c.pdf:files/6516/Pandhare et al. - 2026 - Highly efficient electrolysis platform for quasi-c.pdf:application/pdf},
}

@book{vanli_using_2014,
	title = {{THE} {USING} {OF} {SULPHUR} {HEXAFLUORIDE} ({SF} 6 ) {AS} {A} {COVER} {GAS} {FOR} {PROTECTION} {OF} {MOLTEN} {MAGNESIUM} {ALLOYS}},
	abstract = {Because of its appropriate characteristics like lightness and strength, magnesium alloys have been used and preferred in many sectors especially in automotive, aerospace and electronic industries. During the melting and casting processes of magnesium and its alloys, it must be taken acceptable protective measures to prevent the molten magnesium from oxidizing and burning, because magnesium is a very active and readily ignitable element. Magnesium melt will oxidise rapidly in air, leading to burning on the melt surface. In addition, the eutectic phase Mg 17 Al 12 begins to the oxidation at 430°C. Therefore, the aluminum-containing die-casting magnesium alloys should be protected from temperatures above 400°C, before the melting process begins. In order to process magnesium melt safely, the molten magnesium is protected from oxidation by blanketing the surface with a cover gas. The cover gas reacts with the metal and forms a protective film on the melt surface. Sulphur hexafluoride (SF 6) is widely used by the magnesium industry as a cover gas to inhibit surface oxidation which can result in fires if not controlled. This paper investigates the present works about the characterisation of the surface films formed on molten magnesium protected by cover gas mixtures containing SF 6 in the literature and the industrial area and represents a comparison among the different magnesium alloys, temperatures, gas concentrations, sealing conditions, and protection mechanism of SF 6 containing cover gases on molten magnesium alloys is presented.},
	author = {Vanli, Ali and Akdogan, Anil and Sonmez, Huseyin and Eryildiz, Meltem},
	month = may,
	year = {2014},
	file = {Full Text PDF:files/6517/Vanli et al. - 2014 - THE USING OF SULPHUR HEXAFLUORIDE (SF 6 ) AS A COVER GAS FOR PROTECTION OF MOLTEN MAGNESIUM ALLOYS.pdf:application/pdf},
}

@article{dudek_microstructure_2021,
	title = {Microstructure of castings made of magnesium alloys based on recycling of the circulating scrap},
	volume = {14},
	issn = {2238-7854},
	url = {https://www.sciencedirect.com/science/article/pii/S2238785421007766},
	doi = {10.1016/j.jmrt.2021.07.113},
	abstract = {The increase in the use of magnesium alloys in industry has caused the growth of recycling of a great number of recyclable materials to be exploited. Therefore, recycling of the circulating scrap is getting a high priority technological issue. It is well known that this issue is really tough because of a considerably high reactivity and susceptibility of these alloys to fire up, already below melting temperature. However, recycling of the circulating scrap is essential because, on the one hand, the standards legislation is being tightened up and the foundry running costs have to be reduced, on the other hand. In this study, the influence of the circulating scrap addition on the microstructure and mechanical characteristics of castings obtained with certain scrap addition has been presented. A positive effect of the circulating scrap addition on the strength of tested alloys has been identified. Castings comprising circulating scrap addition have shown the higher ultimate tensiles strength (153 MPa for the scrap percentage of 75\%), in comparison to pure ingots (128 MPa). The circulating scrap addition has also caused the increase in hardness of the obtained castings, however, only in case of its low contributions ({\textasciitilde}80 HB for the circulating scrap addition of 25\% and 50\%).},
	urldate = {2026-10-21},
	journal = {Journal of Materials Research and Technology},
	author = {Dudek, Piotr and Piwowońska, Justyna and Polczyk, Tomasz},
	month = sep,
	year = {2021},
	keywords = {Recycling, Mechanical properties, Microstructure, Scrap, SEM, AZ91 alloy, EDS},
	pages = {2357--2364},
	file = {ScienceDirect Full Text PDF:files/6518/Dudek et al. - 2021 - Microstructure of castings made of magnesium alloys based on recycling of the circulating scrap.pdf:application/pdf;ScienceDirect Snapshot:files/6519/S2238785421007766.html:text/html},
}

@article{feng_review_2026,
	title = {A review of advanced {SOFCs} and {SOECs}: {Materials}, innovative synthesis, functional mechanisms, and system integration},
	volume = {6},
	issn = {2667-1417},
	shorttitle = {A review of advanced {SOFCs} and {SOECs}},
	url = {https://www.sciencedirect.com/science/article/pii/S2667141725000904},
	doi = {10.1016/j.esci.2025.100460},
	abstract = {Solid oxide fuel cells (SOFCs) and solid oxide electrolysis cells (SOECs) are next-generation energy conversion technologies that have attracted widespread attention due to their high efficiency, fuel flexibility, and environmental friendliness. The reversible reaction processes of the two can achieve power generation and energy storage in one device. This paper provides an extensive overview of the latest developments in the field of SOFCs and SOECs, including types, material synthesis, mechanism research, and system integration. First, we introduce the classification of current SOFCs/SOECs according to their different supports and conducting ions. Then, we summarize the synthesis methods and optimization strategies for key materials, including the latest developments in electrolytes, electrodes, and interconnects. Subsequently, the electrochemical mechanisms, including ion transport, electron conduction, electrochemical reaction kinetics, and interfacial phenomena, are analyzed in depth. This paper also outlines challenges and strategies for system integration, such as thermal management, fluid dynamics, and mechanical stress control. Through comprehensive analysis, this review aims to provide researchers with a holistic perspective and guidance for the future development of SOFCs and SOECs. We close by discussing the main challenges and future research directions for further promoting the commercialization and large-scale development of these technologies.},
	number = {2},
	urldate = {2026-10-20},
	journal = {eScience},
	author = {Feng, Peng and Yang, Kuan and Liu, Xuanyou and Zhang, Jiujun and Li, Zhi-Peng},
	month = mar,
	year = {2026},
	keywords = {SOFC, SOEC, Key materials, Mechanism, System integration},
	pages = {100460},
	file = {ScienceDirect Full Text PDF:files/6520/Feng et al. - 2026 - A review of advanced SOFCs and SOECs Materials, innovative synthesis, functional mechanisms, and sy.pdf:application/pdf;ScienceDirect Snapshot:files/6521/S2667141725000904.html:text/html},
}

