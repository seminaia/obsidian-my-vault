	year = {2019},
	pages = {135--145},
	file = {Zhang et al. - 2019 - Thermodynamic properties prediction of Mg-Al-Zn me.pdf:files/4669/Zhang et al. - 2019 - Thermodynamic properties prediction of Mg-Al-Zn me.pdf:application/pdf},
}

