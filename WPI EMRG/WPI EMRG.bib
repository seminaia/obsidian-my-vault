	author = {Romanowski, Chris},
	editor = {Joshi, Vineet V. and Jordon, J. Brian and Orlov, Dmytro and Neelameggham, Neale R.},
	year = {2019},
	note = {Series Title: The Minerals, Metals \& Materials Series},
	pages = {3--12},
	file = {Romanowski - 2019 - Magnesium Alloy Sheet for Transportation Applicati.pdf:files/5069/Romanowski - 2019 - Magnesium Alloy Sheet for Transportation Applicati.pdf:application/pdf},
}

