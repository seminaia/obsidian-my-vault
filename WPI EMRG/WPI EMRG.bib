@article{koo_nucleation_2008,
	title = {Nucleation and growth of {Mg} condensate during supersonic gas quenching},
	volume = {310},
	issn = {00220248},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0022024808000778},
	doi = {10.1016/j.jcrysgro.2008.01.036},
	abstract = {A one-dimensional model based on classical nucleation and growth has been developed as a diagnostic tool for predicting the impact of different process conditions and nozzle geometries on particle size distributions produced from supersonic quenching of magnesium vapours. The model was validated against experimental data for water and SF6, showing good qualitative agreement with the data. For the cases in the study—magnesium concentration from 1 to 20 mol\% and the inlet temperature varying from 1600 to 1900 K—the model predicts that 99\% of the condensation is due to growth of particles nucleated during an initial high nucleation rate stage. The ultimate average particle size is therefore dependent on the magnitude of the nucleation rate during that initial stage of nucleation and to the degree of subsequent growth of those particles which are, in turn, a complex function of the conditions in the nozzle. The distribution of condensate size is somewhat sensitive to the inlet temperature of nozzle, increasing the temperature from 1600 to 1900 K increases the mean size of the condensate by 25\%. The molar concentration of magnesium in the gas affects the ﬁnal particle size but this does not follow a simple trend. The size distribution of particles predicted from the model is very sensitive to changes in surface tension and sticking coefﬁcient, highlighting the need for a more rigorous treatment of these parameters.},
	language = {en},
	number = {10},
	urldate = {2021-10-04},
	journal = {Journal of Crystal Growth},
	author = {Koo, A. and Brooks, G.A. and Nagle, M.},
	month = may,
	year = {2008},
	pages = {2659--2667},
	file = {Koo et al. - 2008 - Nucleation and growth of Mg condensate during supe.pdf:files/4725/Koo et al. - 2008 - Nucleation and growth of Mg condensate during supe.pdf:application/pdf},
}

@article{kuan_modelling_2013,
	title = {Modelling supersonic quenching of magnesium vapour in a {Laval} nozzle},
	volume = {87},
	issn = {00092509},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S000925091200588X},
	doi = {10.1016/j.ces.2012.09.021},
	abstract = {Supersonic quenching of magnesium vapour plays a pivotal role in the carbothermal reduction process for magnesium and the production of fine magnesium powders. Modelling of this process has previously been based on Classical Nucleation Theory in a onedimensional flow expansion without considerations of background gas turbulence and the associated heat and mass transfers. This paper presents a single-phase multi-component fluid model which overcomes the above shortcomings. The model has been validated using steam condensation data and applied to study supersonic quenching of magnesium vapour in a laboratory-scale Laval nozzle. Modelling results indicate a strong dependence of the vapour condensation characteristics on parameters such as vapour concentration and choice of carrier gas. The findings are supported by experimental observations. The model has now become a useful tool for designing and up-scaling processes that utilise supersonic quenching of metallic vapours.},
	language = {en},
	urldate = {2021-10-04},
	journal = {Chemical Engineering Science},
	author = {Kuan, Benny T. and Witt, Peter J.},
	month = jan,
	year = {2013},
	pages = {23--39},
	file = {Kuan and Witt - 2013 - Modelling supersonic quenching of magnesium vapour.pdf:files/4726/Kuan and Witt - 2013 - Modelling supersonic quenching of magnesium vapour.pdf:application/pdf},
}

