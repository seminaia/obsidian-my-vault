@article{velasco_highly_2025,
	title = {Highly reactive bamboo leaf ash via water and acid leaching: {Effects} on cement paste hydration and mortar properties},
	volume = {4},
	issn = {30504716},
	shorttitle = {Highly reactive bamboo leaf ash via water and acid leaching},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S305047162500033X},
	doi = {10.1016/j.macse.2025.100040},
	abstract = {The objective of this study was to produce highly reactive contaminant-free bamboo leaf ashes comparing a water-leaching pretreatment to a conventional acid-leaching technique. Bamboo leaf ashes produced via waterleached (BLA-WL), acid-leached (BLA-AL), and without pretreatment (BLA-IN) were evaluated through physical and chemical characterization. Additionally, the impact of BLA-WL and BLA-AL on the hydration of cementbased pastes was investigated by isothermal calorimetry, X-ray diffraction, and chemical shrinkage, along with their effects on mortar compressive strength and water absorption. These findings were compared to reference mixes without mineral additions and those containing cement replaced by inert quartz. The results demonstrate that acid and water leaching produced highly pozzolanic ashes with minimal contamination. These ashes exhibit significant properties that promote accelerated paste hydration through heterogeneous nucleation and pozzolanic reactions. Concerning mortars, incorporating these ashes significantly improved compressive strength and reduced water absorption, despite the dilution effect associated with cement replacement. Remarkably, both pretreated ashes behaved similarly, confirming that water leaching of bamboo leaves at room temperature is a highly efficient method for obtaining a reactive pozzolan.},
	language = {en},
	urldate = {2025-11-07},
	journal = {Materials Chemistry and Physics: Sustainability and Energy},
	author = {Velasco, Laura Ferreira and Cordeiro, Guilherme Chagas},
	month = sep,
	year = {2025},
	pages = {100040},
	file = {Velasco and Cordeiro - 2025 - Highly reactive bamboo leaf ash via water and acid.pdf:files/3396/Velasco and Cordeiro - 2025 - Highly reactive bamboo leaf ash via water and acid.pdf:application/pdf},
}

