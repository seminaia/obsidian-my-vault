}

@article{lain_modelling_2002,
	title = {Modelling hydrodynamics and turbulence in a bubble column using the {Euler}–{Lagrange} procedure},
	volume = {28},
	issn = {03019322},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0301932202000289},
	doi = {10.1016/S0301-9322(02)00028-9},
	abstract = {This paper describes an extension and validation of the Euler/Lagrange approach for time-dependent calculations of the ﬂow evolving in a bubble column. The continuous phase velocity is obtained by solving the two-dimensional axisymmetric Reynolds-averaged Navier–Stokes equations augmented by the k–e turbulence model. The coupling between the phases is considered through momentum source terms and source terms in the k- and e-equations, which include the eﬀect of wake-generated turbulence by means of consistent Lagrangian-like terms. Bubble motion is calculated by solving the equations of motion taking into account drag force, liquid inertia, added mass, buoyancy and gravity, and the transverse lift force. In order to identify the relative importance of the diﬀerent physical phenomena involved in the model, the radial variation of the corresponding constitutive terms that appear in the transport equations of the liquid variables is analyzed in an instantaneous as well as in the time-averaged conﬁguration. As a conclusion, the bubble source terms are directly responsible for the production of ﬂuctuating kinetic energy and dissipation rate in the liquid, which means that their modelling determines the topology of the liquid ﬂow in the bubble column. For validation the numerical results are quantitatively compared with detailed measurements utilizing phase-Doppler anemometry.},
	language = {en},
	number = {8},
	urldate = {2021-12-14},
	journal = {International Journal of Multiphase Flow},
	author = {Laı́n, S. and Bröder, D. and Sommerfeld, M. and Göz, M.F.},
	month = aug,
	year = {2002},
	pages = {1381--1407},
	file = {Laı́n et al. - 2002 - Modelling hydrodynamics and turbulence in a bubble.pdf:files/4665/Laı́n et al. - 2002 - Modelling hydrodynamics and turbulence in a bubble.pdf:application/pdf},
}

