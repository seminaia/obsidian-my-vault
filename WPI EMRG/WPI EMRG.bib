	doi = {10.1038/s41524-018-0089-4},
	abstract = {Stainless steel corrosion can be successfully simulated using a phase field model that takes into account anodic and cathodic reactions. A team led by San Qiang Shi at the Hong Kong Polytechnic University adapted a phase field method used for simulating metallic microstructure evolution to study corrosive pit growth in stainless steel immersed in mildly salted water. The authors developed equations taking into account the transport and concentration of ionic species and introduced a parameter to describe the changing corrosion interface. The resulting model simulated the corrosion process from the meso- to the macroscale, and successfully showed that two pits can coalesce to form a wider pit, while corrosion occurred preferentially along specific crystallographic planes. Successfully simulating complex corrosion situations may help us better understand them and lessen their impact.},
	language = {en},
	number = {1},
