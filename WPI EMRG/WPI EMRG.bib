@article{yang_revisit_2020,
	title = {Revisit the {VEC} rule in high entropy alloys ({HEAs}) with high-throughput {CALPHAD} approach and its applications for material design-{A} case study with {Al}–{Co}–{Cr}–{Fe}–{Ni} system},
	volume = {192},
	issn = {13596454},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1359645420302263},
	doi = {10.1016/j.actamat.2020.03.039},
	abstract = {Valence electron concentration (VEC) was treated as a useful parameter to predict solid solution phases, and the VEC rule was proposed for high entropy alloys (HEAs). However, this empirical rule has its limitations, which restricts its applications for phase predictions in HEAs. In this paper, we revisited the empirical VEC rule with the HT-CALPHAD approach in the AlÀCoÀCrÀFeÀNi system. Our investigation showed that more than 90\% compositions are observed to have BCC structures when 5.7 VEC 7.2 and we got 100\% FCC structures when VEC 8.4. Meanwhile, we proposed a data screening procedure to classify and discover the new HEAs. The concepts of average density (rHEA), highest BCC/FCC temperatures (TBmCaCx=FCC ), and temperature ranges (DTBCC/FCC) were introduced as useful data screening criteria to down-screen the candidate alloy compositions for speciﬁc engineering applications. In the current work, we have identiﬁed three HEA categories (refractory BCC HEAs, light-weight BCC HEA and refractory FCC HEAs) in the AlÀCoÀCrÀFeÀNi system and proposed the best candidate in each group. More importantly, our investigation showed the HEA non-equiatomic composition space provides ample opportunities for the discovery of the next-generation HEAs.},
	language = {en},
	urldate = {2021-02-10},
	journal = {Acta Materialia},
	author = {Yang, Songge and Lu, Jun and Xing, Fangzhou and Zhang, Lijun and Zhong, Yu},
	month = jun,
	year = {2020},
	pages = {11--19},
	file = {Yang et al. - 2020 - Revisit the VEC rule in high entropy alloys (HEAs).pdf:files/5130/Yang et al. - 2020 - Revisit the VEC rule in high entropy alloys (HEAs).pdf:application/pdf},
}

