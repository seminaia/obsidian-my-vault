@article{gaune-escard_enthalpies_1994,
	title = {Enthalpies of phase transition in the lanthanide chlorides {LaC13}, {CeC13}, {PrC13}, {NdC13}, {GdC13}, {DyC13}, {ErC13} and {TmC13}},
	volume = {204},
	url = {https://doi.org/10.1016/0925-8388(94)90091-4},
	doi = {10.1016/0925-8388(94)90091-4},
	abstract = {The enthalpies of phase transition in the lanthanide chlorides have been measured with a differential scanning calorimeter and also with a Calvet-type microcalorimeter to within an experimental error of \_+2\%. The molar enthalpies of fusion of LaCI3, CeCI3, PrCi3, NdCI3, GdCI3, DyCI3, ErCI3 and TmCI3 are 55.7, 55.5, 52.1, 48.1, 40.6, 22.8, 31.1 and 35.6 kJ mol 1 respectively. The existence of a solid-solid phase transition was found in DyCI3 and ErCI3 at 611 and 1025 K with a molar enthalpy of transition of 1.4 and 5.3 kJ mol-{\textasciitilde} respectively. A significant difference (8.5 kJ mol -{\textasciitilde}) between the absolute values of molar enthalpies of crystallization and fusion was found for LaCI3 at 1124+3 K; this unusual behaviour was explained by an "after-fusion" effect. The entropies of fusion are discussed in terms of structural types of the lanthanide chlorides.},
	language = {en},
	number = {1-2},
	urldate = {2022-06-12},
	journal = {J. Alloys Compd.},
	author = {Gaune-Escard, M and Rycerz, L and Szczepaniak, W and Bogacz, A},
