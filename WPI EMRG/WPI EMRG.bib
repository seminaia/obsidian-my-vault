@article{vitillo_magnesium-based_2015,
	title = {Magnesium-based systems for carbon dioxide capture, storage and recycling: from leaves to synthetic nanostructured materials},
	volume = {5},
	issn = {2046-2069},
	shorttitle = {Magnesium-based systems for carbon dioxide capture, storage and recycling},
	url = {http://xlink.rsc.org/?DOI=C5RA02835C},
	doi = {10.1039/C5RA02835C},
	abstract = {Magnesium is used as leitmotif in this review in order to explore the systems involved in natural and artificial CO
              2
              cycles.
            
          , 
            
              A steep rise of carbon dioxide level in the atmosphere is one of the main causes of global warming. This increase is ascribed to the fact that, since the beginning of the industrial revolution, natural processes for CO
              2
              sequestration are no longer able to cope with the excess of CO
              2
              produced by anthropogenic activities. In recent years, research has been focused on defining artificial CO
              2
              cycles to support the natural one. The element magnesium is used in this review as
              leitmotif
              to explore the majority of systems involved in each step of the natural and artificial CO
              2
              cycles (separation, storage, sequestration or recycling). Magnesium is in fact ubiquitous, being present in the mesosphere as global layers, on the Earth's surface in the most important enzyme for carbon fixation (Rubisco) and in silicates that constitute the major part of rocks, where CO
              2
              is sequestered through natural weathering. For what concerns synthetic materials, zeolites, metal-supported particles and metal–organic frameworks are only a few of the systems considered in the literature. The intent of this review is to connect different fields of study to create an interdisciplinary review in the chemistry domain. Research outlooks are suggested for the different fields. In the end, a qualitative analysis of the advantages and limits of different processes and a rough estimate of their potential are given in terms of the time needed to reduce the atmospheric CO
              2
              level. Although economical, political and health evaluations would be also necessary, this analysis indicates that forestation could be a possible winning solution in the short-middle term for lowering the atmospheric CO
              2
              concentration.},
	language = {en},
	number = {46},
	urldate = {2020-05-06},
	journal = {RSC Adv.},
	author = {Vitillo, Jenny G.},
	year = {2015},
	pages = {36192--36239},
	annote = {Generally, mineral carbonation is a feasible CO2 capture method
Table 8: extreme comparison of capture methods; "time to complete separation" for "mineral carbonation" {\textasciitilde}1.24 to 61 years; lower volume occupied than trees, but more than the creation of liquid CO2; generally, mineral carbonation involves lowest costs, has longest characteristic storage time},
	file = {Vitillo - 2015 - Magnesium-based systems for carbon dioxide capture.pdf:files/5740/Vitillo - 2015 - Magnesium-based systems for carbon dioxide capture.pdf:application/pdf},
}

@article{li_hierarchical_2017,
	title = {Hierarchical {Nanocomposite} by the {Integration} of {Reduced} {Graphene} {Oxide} and {Amorphous} {Carbon} with {Ultrafine} {MgO} {Nanocrystallites} for {Enhanced} {CO} $_{\textrm{2}}$ {Capture}},
	volume = {51},
	issn = {0013-936X, 1520-5851},
	url = {https://pubs.acs.org/doi/10.1021/acs.est.7b03308},
	doi = {10.1021/acs.est.7b03308},
	abstract = {Exploring eﬃcient and low-cost solid sorbents is essential for carbon capture and storage. Herein, a novel class of high-performance CO2 adsorbent (rGO@MgO/C) is engineered based on the controllable integration of reduced graphene oxide (rGO), amorphous carbon, and MgO nanocrystallites. The optimized rGO@MgO/C nanocomposite exhibits remarkable CO2 capture capacity (up to 31.5 wt \% at 27 °C, 1 bar CO2, and 22.5 wt \% under the simulated ﬂue gas), fast sorption rate, and strong process durability. The enhanced capture capability of CO2 is the best among all of the MgO-based sorbents reported so far. The high performance of rGO@MgO/C nanocomposite can be ascribed to the hierarchical architecture and special physicochemical features, including the sheet-on-sheet sandwich-like structure, ultrathin nanosheets with abundant nanopores, large surface area, and highly dispersed ultraﬁne MgO nanocrystallites (ca. 3 nm in size), together with the rGO sheets and in situ generated amorphous carbon that serve as a dual carbon support and protectant system with which to prevent MgO nanocrystallites from agglomeration. In addition, the CO2-uptake capacity at intermediate temperature (e.g., 350 °C) can be further improved threefold through alkali metal salt promotion treatment. This work provides a facile and eﬀective strategy with which to engineer advanced graphene-based functional nanocomposites with rationally designed compositions and architectures for potential applications in the ﬁeld of gas storage and separation.},
	language = {en},
	number = {21},
	urldate = {2020-05-06},
	journal = {Environ. Sci. Technol.},
	author = {Li, Ping and Zeng, Hua Chun},
	month = nov,
	year = {2017},
	pages = {12998--13007},
	annote = {Slit-shaped, mesoporous composite structure with rGO sheets, amorphous C and highly dispersed nanocrystallites of MgO
Very high adsorption capacities compared to commercially-available MgO; experiments lasted around 2 hours at various temperatures (best performance at 27 degrees C, performance drops as increased to 100, 200 degrees C)},
	file = {Li and Zeng - 2017 - Hierarchical Nanocomposite by the Integration of R.pdf:files/5741/Li and Zeng - 2017 - Hierarchical Nanocomposite by the Integration of R.pdf:application/pdf},
}

@article{song_investigation_2016,
	title = {An investigation of {CO2} adsorption kinetics on porous magnesium oxide},
	volume = {283},
	issn = {13858947},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1385894715010219},
	doi = {10.1016/j.cej.2015.07.055},
	abstract = {MgO is a promising adsorbent for CO2 capture. While, its adsorption kinetics under different conditions is not sufﬁciently investigated. Furthermore, the rate-limiting step in CO2 adsorption of MgO cannot be found according to previous study. In this work, the CO2 adsorption kinetics of porous MgO was investigated under wide range of CO2 partial pressure and adsorption temperature. Different adsorption models were used to investigate the adsorption mechanism of porous MgO. It was found that porous MgO showed obvious two-stage adsorption process with a rapid initial CO2 uptake and a subsequent slow adsorption process under wide range of CO2 partial pressure and adsorption temperature. Pseudo-second order model accurately predicted the CO2 adsorption behaviors of porous MgO in all employed adsorption conditions, which indicated the validity of pseudo-second order model in the prediction of chemisorption behavior. The two-stage adsorption process of porous MgO was not caused by the adsorption product generated on the exterior of adsorbent particle. According to the rate-limiting models, the CO2 adsorption process of MgO was controlled by ﬁlm diffusion and intraparticle diffusion. At the initial adsorption process, ﬁlm diffusion resistance governed the adsorption rate. The intraparticle diffusion resistance became a primary factor in the later adsorption step. The narrow pore of porous MgO hindered the diffusion of CO2 molecule and led to a long time to adsorption equilibrium. This study suggests that porous MgO should be prepared with large pore so as to minimize the intraparticle diffusion resistance.},
	language = {en},
	urldate = {2020-05-06},
	journal = {Chemical Engineering Journal},
	author = {Song, Gan and Zhu, Xun and Chen, Rong and Liao, Qiang and Ding, Yu-Dong and Chen, Lin},
	month = jan,
	year = {2016},
	pages = {175--183},
	annote = {Rapid absorption first 20 minutes, followed by slower absorption 200 minutes limited by interparticle diffusion in narrow pores
Proposed four models: two adsorption (1st order, 2nd order; 2nd seemed to fit better), and two diffusion (intraparticle, interparticle; intraparticle seemed to fit better)
Figure 7 shows interparticle diffusion results: independent of pressure, somewhat temperature-dependent},
	file = {Song et al. - 2016 - An investigation of CO2 adsorption kinetics on por.pdf:files/5742/Song et al. - 2016 - An investigation of CO2 adsorption kinetics on por.pdf:application/pdf},
}

@article{guo_nanostructured_2018,
	title = {Nanostructured {MgO} {Sorbents} {Derived} from {Organometallic} {Magnesium} {Precursors} for {Post}-combustion {CO} $_{\textrm{2}}$ {Capture}},
	volume = {32},
	issn = {0887-0624, 1520-5029},
	url = {https://pubs.acs.org/doi/10.1021/acs.energyfuels.8b00866},
	doi = {10.1021/acs.energyfuels.8b00866},
	abstract = {Nanostructured MgO sorbents show promise for intermediate-temperature CO2 capture from post-combustion ﬂue gas stream. However, their CO2 capture behaviors can be aﬀected by the magnesium precursors applied for sorbent synthesis. To screen potential precursors for fabricating excellent CO2 trappers, MgO nanoparticles (NPs) were synthesized by calcining several organometallic precursors, including magnesium ethoxide, magnesium acetate tetrahydrate, magnesium oxalate dehydrate, magnesium lactate dihydrate, magnesium citrate nonahydrate, and magnesium gluconate hydrate. The precursors and MgO NPs were characterized by thermogravimetric analysis, X-ray diﬀraction, N2 adsorption−desorption, ﬁeld emission scanning electron microscopy, and CO2 temperature-programmed desorption. A ﬁxed-bed reactor was used to evaluate the CO2 capture performances of the MgO NPs in a simulated ﬂue gas stream. The eﬀect of organometallic precursors on CO2 capture behaviors of the sorbents was further demonstrated. Results indicated that the diﬀerent precursors would yield MgO NPs with distinct textural and surface properties, and these could further aﬀect their CO2 capture behaviors. MgO NPs derived from magnesium oxalate dehydrate exhibited the highest CO2 uptake of 4.41 mmol of CO2/g. The excellent CO2 uptake was mainly attributed to its superlative textural properties, uniform surface morphology, and abundant base sites.},
	language = {en},
	number = {6},
	urldate = {2020-05-06},
	journal = {Energy Fuels},
	author = {Guo, Yafei and Tan, Chang and Sun, Jian and Li, Weiling and Zhao, Chuanwen and Zhang, Jubing and Lu, Ping},
	month = jun,
	year = {2018},
	pages = {6910--6917},
	annote = {CO2 capture capacities vary due to "precursor effect" on textural/surface properties generated during calcination process},
	file = {Guo et al. - 2018 - Nanostructured MgO Sorbents Derived from Organomet.pdf:files/5743/Guo et al. - 2018 - Nanostructured MgO Sorbents Derived from Organomet.pdf:application/pdf},
}

