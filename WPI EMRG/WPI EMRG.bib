@article{javaid_literature_2006,
	title = {Literature review on magnesium recycling},
	volume = {2006},
	abstract = {Over the last decade, magnesium recycling has become more important because of the increasing use of the metal in transportation as a lightweight material for fuel economy. In order for magnesium to continue to grow, all forms of magnesium scrap need to be recycled - for both economic and environmental reasons. Today, only high-grade magnesium scrap is being recycled and more than half of the remaining low-grade magnesium scrap cannot be recycled economically due to the inability of current sorting and refining technologies to adequately separate and clean the variety of scrap produced. The presence of impurities in magnesium can lead to embrittlement and poor corrosion resistance. Therefore, with the increased use of magnesium there is a growing need for more effective magnesium sorting and refining systems for recycling of all scrap types. This paper reviews current magnesium sorting and refining technologies and explores new techniques on the near horizon.},
	journal = {Magnesium Technology},
	author = {Javaid, Amjad and Essadiqi, E. and Bell, S. and Davis, Boyd},
	month = jan,
	year = {2006},
	pages = {7--12},
}

@book{javaid_final_2006,
	title = {Final {Report} on {Status} of {Metal} {Recycling} {Technologies} in {Metal} {Processing}},
	doi = {10.13140/RG.2.2.24719.38561},
	abstract = {The overall objective of this project is to identify and review the major existing and emerging recycling and refining technologies used in the magnesium, aluminum and steel industries and their impacts on climate change in terms of energy savings and green-house gas (GHG) emission reductions. Some issues that were reviewed and evaluated included: 
• Scrap management, sorting and classification in primary and secondary metal industries of magnesium, aluminum and steel;
• Refining technologies used in primary and secondary metal processing, and removal and reduction of impurities in magnesium, aluminum and steel;
• Design of recyclable products in transportation, construction and energy, particularly the reuse of by-products and the production of alloys that are easy to recycle; and
• Energy efficiency and energy savings related to recycling.
The following reports have been completed in the course of this project:
1. Final report on scrap management, sorting and classification in magnesium.
2. Final report on scrap management, sorting and classification in aluminum.
3. Final report on scrap management, sorting and classification in steel.
4. Final report on refining technologies of magnesium.
5. Final report on refining technologies of aluminum.
6. Final report on refining technologies of steel.
7. Final report on effect of impurities in magnesium.
8. Final report on effect of impurities in aluminum.
9. Final report on effect of impurities in steel.
10. Final Report on design of recyclable products.
11. Final Report on energy efficiency and energy saving in recycling.
The information generated from this literature search will be published and made available to Canadian companies to transfer the knowledge through a website, libraries, report distribution, etc. This report summarizes the work conducted over the span of the project and includes recommendations to provide some direction as to possible areas for improvement/research.},
	author = {Javaid, Amjad and Essadiqi, E. and Bell, S. and Davis, Boyd},
	month = mar,
	year = {2006},
	file = {Full Text PDF:files/3717/Javaid et al. - 2006 - Final Report on Status of Metal Recycling Technolo.pdf:application/pdf},
}

