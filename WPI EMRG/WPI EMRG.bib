@incollection{yang_alumina_2007,
	title = {Alumina {Solubility} in {KF}-{AlF}₃ {Based} {Low}-{Temperature} {Electrolyte} {System}},
	isbn = {978-1-118-00059-5},
	abstract = {The solubility of alumina in a molten KF-AlF₃-based low-temperature electrolyte was determined as a function of the melt composition and temperature by measuring the weight loss of a rotating sintered alumina disc and by using a LECO oxygen analyzer.  The investigated temperature range was 650 to 800°C.  The solubility of alumina increases with the mole ratio (CR), nKF/nAlF from 0.9 mol\% (CR=1.0) to 4.1 mol\% (CR=1.5) at 700°C.  The results suggest that a KF-AlF₃-Al₂O₃-based system can be used as a low-temperature electrolyte in primary aluminum production.},
