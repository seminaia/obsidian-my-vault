	pages = {139--144},
	file = {Rutherford et al. - 2021 - Low-Cost Magnesium Primary Production Using Gravit.xlsm:files/5280/Rutherford et al. - 2021 - Low-Cost Magnesium Primary Production Using Gravit.xlsm:application/vnd.ms-excel.sheet.macroEnabled.12;Rutherford-MgPrimaryTEA.docx:files/5352/Rutherford-MgPrimaryTEA.docx:application/vnd.openxmlformats-officedocument.wordprocessingml.document;Rutherford2021_Chapter_Low-CostMagnesiumPrimaryProduc.pdf:files/5111/Rutherford2021_Chapter_Low-CostMagnesiumPrimaryProduc.pdf:application/pdf},
