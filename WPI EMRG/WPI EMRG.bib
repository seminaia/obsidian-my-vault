	year = {2022},
	note = {Series Title: The Minerals, Metals \& Materials Series},
	pages = {659--668},
	file = {Yan et al. - 2022 - Solid Oxide Membrane (SOM)-Based Technology for Ca.pdf:files/4619/Yan et al. - 2022 - Solid Oxide Membrane (SOM)-Based Technology for Ca.pdf:application/pdf},
}

