@book{vogel_prozessoptimierung_2018,
	address = {Aachen},
	title = {Prozessoptimierung der {Neodym}-{Schmelzflusselektrolyse} zur {Verringerung} von {Treibhausgasemissionen}},
	isbn = {978-3-8440-5793-5},
	abstract = {The electrolysis of neodymium oxide is the most common method for producing rare earth metals, as neodymium is required for producing permanent magnets. The process is conducted at about 1050 °C. Neodymium oxide is fed in the NdF 3 -LiF electrolyte and CO and CO 2 are created at the graphite anode. The greenhouse relevant gaseous perfluorinated carbones (PFC) CF 4 and C 2 F 6 are generated at high anode potentials. There is no known process automation and no direct voltage adjustment leading to the assumption that the electrolysis is conducted with a continuous PFC emission leading to a climate relevant amount of greenhouse gases, which need to be taken into account as a global anthropogenic PFC source. In the theoretical part of this work, a model of the cell voltage is transferred from the aluminium electrolysis to the neodymium electrolysis. The experimental part describes the relation between the anodic emission, the cell voltage, the current density and the oxide concentration of the electrolyte. Based on the model and the experimental characteristics a process control is defined within a PFC free process window. Continuous electrolysis experiments show significant amounts of PFC emission and the effect of an automated process control, which can also react to the gas emission. The feasibility is demonstrated to minimize the PFC emission of the neodymium electrolysis.

Neodym ist aufgrund seiner Nutzung als Magnetrohstoff mengenmäßig das wichtigste Metall der Seltenen Erden. Damit ist die Neodymschmelzflusselektrolyse die bedeutendste Methode zur Erzeugung von Seltenerdmetallen. Der Elektrolyseprozess läuft bei etwa 1050 °C im NdF 3 -LiF-Elektrolyten ab, in den das Neodymoxid hinzugegeben wird. An der Graphitanode wird CO, sowie CO 2 gebildet. Die treibhausrelevanten gasförmigen Perfluorcarbone (PFC) CF 4 und C 2 F 6 werden bei hohen Anodenpotentialen erzeugt. Da es keine bekannte Prozessautomation gibt, wird die Elektrolyse wahrscheinlich mit einer kontinuierlichen PFC-Emission betrieben, die eine klimarelevante Dimension annehmen kann und als globale anthropogene PFC-Quelle berücksichtigt werden muss. Zur Beschreibung einer Prozesskontrolle wird im theoretischen Teil dieser Arbeit das Zellspannungsmodell von der Aluminiumelektrolyse auf die Neodymelektrolyse übertragen. Der experimentelle Teil der Arbeit beschreibt den Zusammenhang zwischen der anodischen Gasbildung, der Zellspannung, der Stromdichte und dem Oxidgehalt im Elektrolyten. Aufbauend auf dem Zellspannungsmodell, Prozesssteuerung mit kann einem mithilfe PFC-freien dieser Charakterisierung Prozessfenster definiert eine werden. Kontinuierliche Elektrolyseversuche zeigen die erhebliche Menge an PFC-Emissionen und die Effekte einer automatischen Prozesssteuerung, die auch auf die Gasentwicklung reagieren kann. Somit wird gezeigt, dass die Minimierung von PFC-Emissionen für die Neodymelektrolyse erreichbar ist.},
	language = {de},
	publisher = {Shaker Verlag GmbH},
	author = {Vogel, Hanno},
	year = {2018},
	note = {Published PhD thesis, OCLC: 1030387944},
	keywords = {MQP},
	file = {Vogel - 2018 - Prozessoptimierung der Neodym-Schmelzflusselektrol.pdf:files/5150/Vogel - 2018 - Prozessoptimierung der Neodym-Schmelzflusselektrol.pdf:application/pdf},
}

