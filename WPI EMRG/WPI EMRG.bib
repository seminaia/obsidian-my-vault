@inproceedings{scarponi_slurry_2021,
	address = {College Station, Texas},
	title = {Slurry of {Magnesium} {Hydride} and {Jet} {Fuel}: {A} {Potential} {Net}-{Zero} {Carbon} {Dioxide} {Emitting} {Aviation} {Fuel}},
	abstract = {Aviation accounts for 2.5\% of the world’s fossil fuel carbon dioxide (CO₂) emissions. Based on the projected growth of the industry, the emissions are estimated to triple by 2050. Other considered alternatives such as batteries, liquid hydrogen, and ammonia do not have the energy/volume and/or energy/mass to replace fossil fuels used for air travel. This work explores the feasibility of using a slurry of solid MgH₂ particles suspended in a traditional jet fuel as a net zero-CO₂ emitting aviation fuel. MgO particles in the combustion products are expected to react with CO2 in the plume and atmosphere forming MgCO₃ and Mg(HCO₃)₂ . Slurry having Mg:C molar ratio of 1:1 (or greater) could result in net-zero (or net-negative) CO₂ emissions. Thermodynamic calculations performed using n-dodecane as a jet fuel surrogate reveal that the slurry has {\textasciitilde}24\% lower energy/mass and {\textasciitilde}17\% higher energy/volume compared to n-dodecane at engine-relevant conditions. The increased energy/volume translates to {\textasciitilde}8\% longer aircraft range, though other aircraft changes required to accommodate the denser slurry could offset that range extension. Droplet combustion studies reveal some aspects of the mechanism of slurry combustion. Liquid hydrocarbon is consumed first leaving behind a solid agglomerate. Dissociation of MgH₂ then occurs releasing H₂, which results in an increase in the burning rate. Finally, the remaining solid fuel is consumed at a slower rate.},
	language = {en},
	booktitle = {12th {U}.{S}. {National} {Combustion} {Meeting}},
	publisher = {Combustion Institute},
	author = {Scarponi, Jake and Wu, Yi Jie and Powell, Adam Clayton and Jayachandran, Jagannath},
	month = may,
	year = {2021},
	file = {Scarponi et al. - Slurry of Magnesium Hydride and Jet Fuel A Potent.pdf:files/4640/Scarponi et al. - Slurry of Magnesium Hydride and Jet Fuel A Potent.pdf:application/pdf},
}

