	url = {https://pubs.acs.org/doi/abs/10.1021/j100810a038},
	doi = {10.1021/j100810a038},
	abstract = {The density of liquid magnesium was measured over its normal liquid range (923-1390oK) by the Archimedian method.  The dependence of density on temperature is expressed by the linear equation D g./cm3 = 1.834-2.647 x 10-4 T oK, with a probable error of +-0.0014 g./cm.3.  The density of liquid magnesium is 1.590 g./cm.3 at its melting point and 1.466 g./cm.3 at its boiling point.  The volume increase on fusion is 2.96\% of the liquid volume.  The estimated critical constants of magnesium are: Tc = 3850 +- 400oK., Pc = 1730 (+800 or -700) atm., Vc = 59 +- 8.0 cm.3, and Dc = 0.41 +- 0.05 g./cm.3.  Density values and the temperature coefficient obtained experimentally are in reasonable agreement with those predicted on the basis of an average reduced temperature vs. reduced density diagram constructed from data on six metals.},
	language = {en},
	number = {4},
	urldate = {2020-06-02},
	journal = {J. Phys. Chem.},
	author = {McGonigal, P. J. and Kirshenbaum, A. D. and Grosse, A. V.},
