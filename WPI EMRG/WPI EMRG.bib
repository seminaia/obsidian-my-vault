@article{wang_ultra-high_2026,
	title = {Ultra-high purification efficiency of magnesium via liquid aluminum},
	volume = {380},
	issn = {13835866},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1383586625037852},
	doi = {10.1016/j.seppur.2025.135188},
	abstract = {Magnesium (Mg), prone to impurity-induced degradation even at ppm levels, is traditionally purified through vacuum distillation in industrial settings. However, entrainment of impurities in the Mg vapor reduces separation efficiency, thereby necessitating multiple distillation steps to obtain high-purity (HP) Mg ({\textgreater}99.999 wt\%, 5 N). To address this limitation, aluminum (Al) melt was introduced into the vacuum distillation process to absorb impurities from Mg vapor actively. Impurity elements, such as Fe, Ni, Cu, Al, Si, and Ca can be reduced to concentrations below 0.1 ppm. Zn, a challenging impurity to remove through conventional vacuum distillation, can be reduced to 1.78 ppm by increasing the crystallization temperature to 620 ◦C. With this approach, crude Mg with a purity 99.6 wt\% can be directly refined to 99.9997 wt\% (5 N7) ultrahigh-purity (UHP) Mg in a single distillation step. This novel approach, by introducing liquid metals into the vacuum distillation process, significantly enhances purification efficiency and increases the feedstock’s impurity tolerance.},
	language = {en},
	urldate = {2026-05-13},
	journal = {Separation and Purification Technology},
	author = {Wang, An and Lu, Si-Ying and Liu, Bo-Yu and Zeng, Rong-Chang and Shan, Zhi-Wei},
	month = feb,
	year = {2026},
	pages = {135188},
	file = {PDF:files/3325/Wang et al. - 2026 - Ultra-high purification efficiency of magnesium via liquid aluminum.pdf:application/pdf},
}

