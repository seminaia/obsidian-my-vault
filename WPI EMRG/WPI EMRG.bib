@phdthesis{zhang_comprehensive_2025,
	address = {Worcester, MA, USA},
	type = {Ph.{D}.},
	title = {Comprehensive {Molecular} {Dynamics} {Modeling} of {Fluoride} {Molten} {Salts}},
	url = {https://digital.wpi.edu/concern/etds/g732df10j},
	abstract = {Fluoride-based  molten  salts  play  a  central  role  in  emerging  energy  technologies, particularly for molten salt reactors (MSRs) and thermal storage at high temperatures. Their remarkable thermophysical properties render them exceptionally well-suited for operations under  extreme  conditions.  However,  experimental  investigations  are  often  constrained  by elevated temperatures and the complex ionic interactions characteristic of molten states. This dissertation addresses these challenges by focusing on the fluoride systems, i.e. LiF-NaF-KF (FLiNaK), NaF-ZrF₄, CaF₂-MgF₂ eutectic and its higher-order derivatives containing oxides and silica, using advanced computational methods to circumvent experimental limitations and provide in-depth insights into structural, thermodynamic, and transport behaviors. Additionally, it explores the interfacial dynamics between CaF₂-MgF₂ electrolyte and the yttria-stabilized zirconia (YSZ) substance, elucidating potential corrosion mechanisms and their implications for both phases.

A combination of computational methods, such as molecular dynamics (MD), density functional  theory  (DFT),  and  the  CALPHAD  thermodynamic  approach,  provides  reliable analyses of key properties like density, diffusivity, viscosity, and important structural insights from radial and angular distribution functions. By addressing key gaps, such as the lack of reliable  high-temperature  models  and  a  limited  understanding  of  ionic  interactions  within (CaF2-MgF2)-based  melts,  this  research  aims  to  significantly  advance  both  theoretical frameworks and practical applications. The findings yield methodological innovations that can be transferred to diverse molten salt systems, ultimately informing the design and optimization of future high-temperature energy technologies.},
	language = {en},
	urldate = {2026-10-04},
	school = {Worcester Polytechnic Institute},
	author = {Zhang, Yifan},
	month = apr,
	year = {2025},
	file = {Zhang - Comprehensive Molecular Dynamics Modeling of Fluor.pdf:files/6500/Zhang - Comprehensive Molecular Dynamics Modeling of Fluor.pdf:application/pdf},
}

