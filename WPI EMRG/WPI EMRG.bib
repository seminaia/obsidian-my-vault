@article{chae_experimental_2014,
	series = {{SI} : {ISMANAM} 2012},
	title = {Experimental investigation of diffusion behavior between molten {Mg} and {Nd}–{Fe}–{B} magnets},
	volume = {586},
	issn = {0925-8388},
	url = {https://www.sciencedirect.com/science/article/pii/S0925838813004866},
	doi = {10.1016/j.jallcom.2013.02.156},
	abstract = {This study presents the experimental results of neodymium (Nd) extraction from the Nd–Fe–B magnetic alloy by liquid magnesium (Mg). A sample of Nd–Fe–B alloy was placed in an Fe crucible with pure Mg under an Ar atmosphere and melted by induction heating. In order to identify the reaction mechanism, the effects of melting temperature (993–1073K) and holding time (2–120min) on the extraction ability were investigated. The diffusion behavior was analyzed by scanning electron microscopy (SEM) and energy dispersive spectroscopy (EDS) and the constituent phases were characterized by X-ray diffraction (XRD). It was found that Nd from the Nd–Fe–B alloy diffused readily into liquid Mg. The reaction rate was dependent both on temperature and time. This study demonstrates that liquid metal extraction of Nd could be a viable and inexpensive method for recovery of the expensive rare earth element Nd using Mg castings.},
	language = {en},
	urldate = {2023-04-07},
	journal = {Journal of Alloys and Compounds},
	author = {Chae, Hong Jun and Kim, Young Do and Kim, Bum Sung and Kim, Jeong Gon and Kim, Taek-Soo},
	month = feb,
	year = {2014},
	keywords = {Nd–Fe–B, Recycling, Liquid metal extraction, Neodymium, Rare-earth elements},
	pages = {S143--S149},
	file = {Chae et al. - 2014 - Experimental investigation of diffusion behavior b.pdf:files/3478/Chae et al. - 2014 - Experimental investigation of diffusion behavior b.pdf:application/pdf;ScienceDirect Snapshot:files/3999/S0925838813004866.html:text/html},
}

