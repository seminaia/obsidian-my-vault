@incollection{ghosh_carbon_2019,
	address = {Singapore},
	title = {Carbon {Footprint} {Assessment} of {Recycling} {Fluorspar} from {Waste} {Calcium} {Fluoride} ({CaF2}) {Sludge}},
	isbn = {978-981-10-7289-5 978-981-10-7290-1},
	url = {http://link.springer.com/10.1007/978-981-10-7290-1_57},
	doi = {10.1007/978-981-10-7290-1_57},
	abstract = {Waste has been identified as one of the main sources of greenhouse gas (GHG) emissions that result from global population growth. Climate change and resource scarcity have emerged as pressing environmental issues in recent years. Resource recycling and recovery have been proven effective ways of implementing circular economy and achieving GHG reduction to maintain sustainable resource use. Calcium fluoride sludge and hydrofluoric acid are the primary wastes generated from the electronics industry, such as from semiconductors, liquid crystal displays, lightemitting diodes, solar cells, and other optoelectronic sectors. The accumulation of such waste has become a major problem of Taiwan’s electronics industry. If not properly treated or managed, then electronic waste would cause serious health and environmental problems; however, if recycled, then they can be recovered and transformed into artificial fluorite (CaF2) and sodium fluorosilicate (NaSiF6), which have economic and environmental benefits. Moreover, both materials can be used as substitutes for cement in construction. The main objective of this study is to evaluate the carbon footprint of renewable material from calcium fluoride sludge to understand the carbon emission of waste reuse method from a life cycle perspective. The scope and system boundary of the assessment are determined on the basis of a literature review and expert consultation. Data for calculating carbon footprints were collected through in-plant inventory and from the literature. The carbon footprint of artificial fluorite is 297.87 kg CO2eq/ton, and that of the raw material, manufacturing, and pollution control stages are 65.8, 216.9, and 16 kg CO2eq/ton, respectively. The results can be used to develop strategies for life cycle management of waste reuse to realize sustainable materials management. Future research will be extended to the area of raw fluorite mining and transportation to compare the carbon reduction benefit achieved with artificial fluorite remanufacturing technology.},
	language = {en},
	urldate = {2021-08-18},
	booktitle = {Waste {Management} and {Resource} {Efficiency}},
	publisher = {Springer Singapore},
	author = {Hu, Allen H. and Kuo, Chien-Hung and Hong, Ciao-Sin and Huang, Lance Hongwei},
	editor = {Ghosh, Sadhan Kumar},
	year = {2019},
	pages = {685--693},
	file = {Hu et al. - 2019 - Carbon Footprint Assessment of Recycling Fluorspar.pdf:files/4787/Hu et al. - 2019 - Carbon Footprint Assessment of Recycling Fluorspar.pdf:application/pdf},
}

