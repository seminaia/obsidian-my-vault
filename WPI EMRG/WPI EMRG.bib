@article{toktarova_pathways_2020,
	title = {Pathways for {Low}-{Carbon} {Transition} of the {Steel} {Industry}—{A} {Swedish} {Case} {Study}},
	volume = {13},
	issn = {1996-1073},
	url = {https://www.mdpi.com/1996-1073/13/15/3840},
	doi = {10.3390/en13153840},
	abstract = {The concept of techno-economic pathways is used to investigate the potential implementation of CO2 abatement measures over time towards zero-emission steelmaking in Sweden. The following mitigation measures are investigated and combined in three pathways: top gas recycling blast furnace (TGRBF); carbon capture and storage (CCS); substitution of pulverized coal injection (PCI) with biomass; hydrogen direct reduction of iron ore (H-DR); and electric arc furnace (EAF), where fossil fuels are replaced with biomass. The results show that CCS in combination with biomass substitution in the blast furnace and a replacement primary steel production plant with EAF with biomass (Pathway 1) yield CO2 emission reductions of 83\% in 2045 compared to CO2 emissions with current steel process conﬁgurations. Electriﬁcation of the primary steel production in terms of H-DR/EAF process (Pathway 2), could result in almost fossil-free steel production, and Sweden could achieve a 10\% reduction in total CO2 emissions. Finally, (Pathway 3) we show that increased production of hot briquetted iron pellets (HBI), could lead to decarbonization of the steel industry outside Sweden, assuming that the exported HBI will be converted via EAF and the receiving country has a decarbonized power sector.},
	language = {en},
	number = {15},
	urldate = {2021-02-19},
	journal = {Energies},
	author = {Toktarova, Alla and Karlsson, Ida and Rootzén, Johan and Göransson, Lisa and Odenberger, Mikael and Johnsson, Filip},
	month = jul,
	year = {2020},
	pages = {3840},
	file = {Toktarova et al. - 2020 - Pathways for Low-Carbon Transition of the Steel In.pdf:files/5119/Toktarova et al. - 2020 - Pathways for Low-Carbon Transition of the Steel In.pdf:application/pdf},
}

