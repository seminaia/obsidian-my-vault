@article{jayakumar_direct_2011,
	title = {A direct carbon fuel cell with a molten antimony anode},
	volume = {4},
	url = {http://dx.doi.org/10.1039/C1EE01863A},
	doi = {10.1039/C1EE01863A},
	abstract = {The direct utilization of carbonaceous fuels is examined in a solid oxide fuel cell (SOFC) with a molten Sb anode at 973 K. It is demonstrated that the anode operates by oxidation of metallic Sb at the electrolyte interface, with the resulting Sb2O3 being reduced by the fuel in a separate step. Although the Nernst Potential for the Sb-Sb2O3 mixture is only 0.75 V, the electrode resistance associated with molten Sb is very low, approximately 0.06 Ωcm2, so that power densities greater than 350 mW cm−2 were achieved with an electrolyte-supported cell made from Sc-stabilized zirconia (ScSZ). Temperature programmed reaction measurements of Sb2O3 with sugar char, rice starch, carbon black, and graphite showed that the Sb2O3 is readily reduced by a range of carbonaceous solids at typical SOFC operating conditions. Finally, stable operation with a power density of 300 mW cm−2 at a potential of 0.5 V is demonstrated for operation on sugar char.},
	number = {10},
	journal = {Energy Environ. Sci.},
	author = {Jayakumar, Abhimanyu and Küngas, Rainer and Roy, Sounak and Javadekar, Ashay and Buttrey, Douglas J. and Vohs, John M. and Gorte, Raymond J.},
	year = {2011},
	pages = {4133--4137},
	annote = {300 mW/cm² max 700°C
},
	file = {Jayakumar et al. - 2011 - A direct carbon fuel cell with a molten antimony a.pdf:files/6111/Jayakumar et al. - 2011 - A direct carbon fuel cell with a molten antimony a.pdf:application/pdf},
}

