@incollection{barakos_chapter_2016,
	address = {Boston},
	title = {Chapter 8 - {Rare} {Earth} {Underground} {Mining} {Approaches} with {Respect} to {Radioactivity} {Control} and {Monitoring} {Strategies}},
	isbn = {978-0-12-802328-0},
	url = {https://www.sciencedirect.com/science/article/pii/B9780128023280000085},
	doi = {10.1016/B978-0-12-802328-0.00008-5},
	abstract = {All rare earth deposits contain natural occurring radioactive materials primarily composed of radionuclides from the decay series of elements such as uranium and thorium, and especially products such as radon. Contents of these materials are variable. Often, occupational and environmental radiation exposure during mining needs to be assessed carefully during the selection of appropriate technologies. The restriction of exposure to radon is the main target to helping maintain a safe underground working environment. Mine ventilation is the primary technique of controlling ambient concentrations of radon spread. This chapter attempts to determine radon dispersion sources and risks related to radiation exposure. Evaluations are made of boundary conditions and technologies that can contribute to restricting and removing radon from underground mine air.},
	language = {en},
