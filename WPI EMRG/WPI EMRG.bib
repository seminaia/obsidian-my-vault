@article{chen_room-temperature_2025,
	title = {Room-temperature {CO2}-to-carbon conversion facilitated by copper-gallium liquid metal},
	volume = {507},
	issn = {13858947},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S138589472501410X},
	doi = {10.1016/j.cej.2025.160589},
	abstract = {Reducing CO2 emissions is crucial for the future survival of the planet, and there is a growing demand for innovative technologies to capture and reduce CO2, with a specific focus on achieving global net-zero carbon emissions. Consequently, the direct conversion of CO2 to carbon presents an exceptionally promising pathway; however, conventional thermal and catalytic approaches face challenges due to their high energy requirements and limitations imposed by coking. This study introduces a liquid metal-based system containing copper (Cu) that exhibits remarkable performance in terms of high yield, safety, and on-demand capability for continuous reduction of CO2 to solid carbon at room temperature and atmospheric pressure. In this process, the highly efficient electron transfer properties of liquid metals based on Ga are combined with the strong reactivity of Cu and its robust affinity for CO2. This unique combination plays a pivotal role in driving the dissociation of CO2 into its fundamental constituents carbon and oxygen. The high solubility and stability of dimethylformamide (DMF) as a solvent greatly enhance conversion efficiency and yield 2598.7 μmol/h solid carbonaceous materials at 40 ◦C, enabling a sustainable approach for CO2 reduction. The catalyst system exhibits remarkable stability and recyclability, making it highly promising for carbon reduction applications. Additionally, it provides valuable insights into the development of non-precious metal catalysis and the conversion of high-value solid carbonaceous materials.},
	language = {en},
	urldate = {2026-08-25},
	journal = {Chemical Engineering Journal},
	author = {Chen, Xiao and Liu, Jiacheng and Wang, Qing and Fu, Mengmeng and Li, Yunlong and He, Jialun and Zhan, Wenjun and Liu, Litian and Jiang, Danfeng and Li, Yingguo and Yu, Chao},
	month = mar,
	year = {2025},
	pages = {160589},
	file = {PDF:files/6399/Chen et al. - 2025 - Room-temperature CO2-to-carbon conversion facilitated by copper-gallium liquid metal.pdf:application/pdf},
}

