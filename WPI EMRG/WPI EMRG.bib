@article{sand_multi-model_2023,
	title = {A multi-model assessment of the {Global} {Warming} {Potential} of hydrogen},
	volume = {4},
	issn = {2662-4435},
	url = {https://www.nature.com/articles/s43247-023-00857-8},
	doi = {10.1038/s43247-023-00857-8},
	abstract = {Abstract
            With increasing global interest in molecular hydrogen to replace fossil fuels, more attention is being paid to potential leakages of hydrogen into the atmosphere and its environmental consequences. Hydrogen is not directly a greenhouse gas, but its chemical reactions change the abundances of the greenhouse gases methane, ozone, and stratospheric water vapor, as well as aerosols. Here, we use a model ensemble of five global atmospheric chemistry models to estimate the 100-year time-horizon Global Warming Potential (GWP100) of hydrogen. We estimate a hydrogen GWP100 of 11.6 ± 2.8 (one standard deviation). The uncertainty range covers soil uptake, photochemical production of hydrogen, the lifetimes of hydrogen and methane, and the hydroxyl radical feedback on methane and hydrogen. The hydrogen-induced changes are robust across the different models. It will be important to keep hydrogen leakages at a minimum to accomplish the benefits of switching to a hydrogen economy.},
	language = {en},
	number = {1},
	urldate = {2025-01-17},
	journal = {Commun Earth Environ},
	author = {Sand, Maria and Skeie, Ragnhild Bieltvedt and Sandstad, Marit and Krishnan, Srinath and Myhre, Gunnar and Bryant, Hannah and Derwent, Richard and Hauglustaine, Didier and Paulot, Fabien and Prather, Michael and Stevenson, David},
	month = jun,
	year = {2023},
	pages = {203},
	file = {Sand et al. - 2023 - A multi-model assessment of the Global Warming Pot.pdf:files/3529/Sand et al. - 2023 - A multi-model assessment of the Global Warming Pot.pdf:application/pdf},
}

@article{wu_novel_2024,
	title = {A novel biomass modified brown coal as composite fuel for high performance direct carbon solid oxide fuel cells},
	volume = {363},
	issn = {00162361},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0016236124001972},
	doi = {10.1016/j.fuel.2024.131051},
	abstract = {Direct carbon solid oxide fuel cell (DC-SOFC) is a novel and efficient power generation device which utilizes solid carbon through electrochemical oxidation. Thereinto, clean and highly efficient utilization of coal is an impor­ tant way to realize the “dual carbon” strategic goals. Nevertheless, the DC-SOFC performances with coal fuel are commonly low due to the certain amounts of inherent impurities of ashes and volatilizations. Taking this into account, a novel composite coal-based fuel is ingeniously designed as fuel for DC-SOFCs, in which the brown coal char is modified by adding a small proportion of kelp biomass carbon. With the configuration of AgCe0.9Gd0.1O2-δ/YSZ/Ag-Ce0.9Gd0.1O2-δ symmetrical cell structure, the maximum power density of the cell with the novel composite fuel can reach 299 mW cm− 2 at 850 ℃, which is outstandingly promoted compared to the cell with pure brown coal char (242 mW cm− 2). Likewise, the composite fuel fed DC-SOFC presents a prolonged discharge stability than the kelp biochar fueled cell. This study introduces a novel concept of composite fuel for DC-SOFCs, which offers a new way for the development of high-performance direct brown coal fuel cells or direct carbon fuel cells with other coal fuel with the feature of highly efficient and clean use of coal for power generation.},
	language = {en},
	urldate = {2025-01-11},
	journal = {Fuel},
	author = {Wu, Hao and Zeng, Xiaoyuan and Hao, Senran and Liu, Boyuan and Zhang, Yingjie and Xie, Yongmin and Liu, Yan and Xiao, Jie and Wu, Can and Dong, Peng},
	month = may,
	year = {2024},
	pages = {131051},
	file = {Wu et al. - 2024 - A novel biomass modified brown coal as composite f.pdf:files/3530/Wu et al. - 2024 - A novel biomass modified brown coal as composite f.pdf:application/pdf},
}

@article{wang__performance_2023,
	title = {Performance {Improvement} of a {Direct} {Carbon} {Fuel} {Cell} through an {Irreversible} {Vacuum} {Thermionic} {Generator}},
	volume = {40},
	issn = {0256-307X, 1741-3540},
	url = {https://iopscience.iop.org/article/10.1088/0256-307X/40/12/128201},
	doi = {10.1088/0256-307X/40/12/128201},
	abstract = {A novel hybrid system consisting of a direct carbon fuel cell (DCFC), a thermionic generator (TIG), and a regenerator is developed to recover the exhaust heat from the fuel cell. Expressions for the power output and efficiency of subsystems and the hybrid system are derived. Based on the energy balance equation, the area matching problem between the DCFC and the TIG is discussed and solved. By considering the main irreversibilities, the influences of the DCFC’s current density and the TIG’s voltage on the performance of the hybrid system are revealed. The maximum power output density and the corresponding efficiency of the hybrid system are, respectively, equal to 379 W/m
              2
              and 36\%. To enhance the maximum power density of the single DCFC, the optimal regions of the main parameters are determined.},
