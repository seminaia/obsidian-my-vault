@article{teyber_passive_2018,
	title = {Passive force balancing of an active magnetic regenerative liquefier},
	volume = {451},
	issn = {03048853},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0304885317329086},
	doi = {10.1016/j.jmmm.2017.11.002},
	abstract = {Active magnetic regenerators (AMR) have the potential for high efﬁciency cryogen liquefaction. One active magnetic regenerative liqueﬁer (AMRL) conﬁguration consists of dual magnetocaloric regenerators that reciprocate in a persistent-mode superconducting solenoid. Issues with this conﬁguration are the spatial and temporal magnetization gradients that induce large magnetic forces and winding currents. To solve the coupled problem, we present a force minimization approach using passive magnetic material to balance a dual-regenerator AMR. A magnetostatic model is developed and simulated force waveforms are compared with experimental measurements. A genetic algorithm identiﬁes force-minimizing passive structures with virtually ideal balancing characteristics. Implementation details are investigated which afﬁrm the potential of the proposed methodology.},
	language = {en},
	urldate = {2026-09-10},
	journal = {Journal of Magnetism and Magnetic Materials},
	author = {Teyber, R. and Meinhardt, K. and Thomsen, E. and Polikarpov, E. and Cui, J. and Rowe, A. and Holladay, J. and Barclay, J.},
	month = apr,
	year = {2018},
	pages = {79--86},
	file = {Teyber et al. - 2018 - Passive force balancing of an active magnetic rege.pdf:files/6461/Teyber et al. - 2018 - Passive force balancing of an active magnetic rege.pdf:application/pdf},
}

