	issn = {00224596},
	url = {http://arxiv.org/abs/0712.0314},
	doi = {10.1016/j.jssc.2008.02.017},
	abstract = {The phase diagram gadolinium ﬂuoride – lutetium ﬂuoride was determined by diﬀerential scanning calorimetry (DSC) and X-ray powder diﬀraction analysis. Both pure components undergo a reversible ﬁrst order transformation to a high temperature phase. The mutual solubility of both components is unlimited in the orthorhombic room temperature phase. The maximum solubility of Lu in the high temperature phase of GdF3 (tysonite type) is about 20\% and the maximum solubility of Gd in LuF3 (α-YF3 type) is about 40\%. Intermediate compositions of the low temperature phase decompose upon heating in a peritectoid reaction to a mixture of both high temperature phases.},
	language = {en},
