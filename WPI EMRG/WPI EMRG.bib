@book{committee_on_developing_a_research_agenda_for_carbon_dioxide_removal_and_reliable_sequestration_negative_2019,
	address = {Washington, D.C.},
	title = {Negative {Emissions} {Technologies} and {Reliable} {Sequestration}: {A} {Research} {Agenda}},
	isbn = {978-0-309-48452-7},
	shorttitle = {Negative {Emissions} {Technologies} and {Reliable} {Sequestration}},
	url = {https://www.nap.edu/catalog/25259},
	doi = {10.17226/25259},
	abstract = {To achieve goals for climate and economic growth, “negative emissions technologies” (NETs) that remove and sequester carbon dioxide from the air will need to play a significant role in mitigating climate change. Unlike carbon capture and storage technologies that remove carbon dioxide emissions directly from large point sources such as coal power plants, NETs remove carbon dioxide directly from the atmosphere or enhance natural carbon sinks. Storing the carbon dioxide from NETs has the same impact on the atmosphere and climate as simultaneously preventing an equal amount of carbon dioxide from being emitted. Recent analyses found that deploying NETs may be less expensive and less disruptive than reducing some emissions, such as a substantial portion of agricultural and land-use emissions and some transportation emissions.},
	language = {en},
	urldate = {2019-12-04},
	publisher = {National Academies Press},
	author = {{Committee on Developing a Research Agenda for Carbon Dioxide Removal and Reliable Sequestration} and {Board on Atmospheric Sciences and Climate} and {Board on Energy and Environmental Systems} and {Board on Agriculture and Natural Resources} and {Board on Earth Sciences and Resources} and {Board on Chemical Sciences and Technology} and {Ocean Studies Board} and {Division on Earth and Life Studies} and {National Academies of Sciences, Engineering, and Medicine}},
	month = mar,
	year = {2019},
	file = {Committee on Developing a Research Agenda for Carbon Dioxide Removal and Reliable Sequestration et al. - 2019 - Negative Emissions Technologies and Reliable Seque.pdf:files/5953/Committee on Developing a Research Agenda for Carbon Dioxide Removal and Reliable Sequestration et al. - 2019 - Negative Emissions Technologies and Reliable Seque.pdf:application/pdf},
}

@article{wilcox_strategy_nodate,
	title = {Strategy for {Jumpstarting} {Modular} {DAC}},
	abstract = {The importance of the role that negative emissions technologies will play in preventing 2 °C warming by 2100 is becoming increasingly clear. The next decade is critical in terms of technological innovation and deployment if we are to meet our mid-century carbon removal goals of 10 – 20 GtCO₂/yr. Direct air capture (DAC) is positioned to play a critical role in carbon removal, yet remains under paced in deployment efforts, mainly due to high costs. This study outlines a roadmap for DAC cost reductions through the exploitation of low-temperature heat, recent US policy drivers, and logical, regional end-use opportunities in the US. Specifically, three scenarios are identified that allow for the production of compressed high-purity CO₂ for costs of \$300/tCO₂ and below, net delivered. These scenarios use thermal energy from geothermal and nuclear power plants, in addition to the direct use of stranded natural gas to produce steam and truck the purified CO₂ to the nearest opportunity for direct use or injection into the earth for permanent storage. While some utilization pathways result in the re-emission of CO₂ and cannot be considered true carbon removal, it was recognized that they provide economic incentive to deploying DAC plants, which is an essential first step toward reaching the required deployment scale by mid-century. In addition, the federal tax credit 45Q was applied for qualifying facilities, (i.e., when CO₂ production streams met the minimum requirement of 100 ktCO₂ /yr).},
	language = {en},
	journal = {Energy \& Environmental Science},
	author = {Wilcox, Jennifer and Psarras, Peter and Pilorgé, Hélène and McQueen, Noah and Liguori, Simona and He, Jiajun and Yuan, Mengyao and Woodall, Caleb M and Kian, Kourosh and Pierpoint, Lara and Jurewicz, Jacob and Lucas, J Matthew and Jacobson, Rory and Diech, Noah},
	file = {EES_DAC Siting_JW.pdf:files/5914/EES_DAC Siting_JW.pdf:application/pdf},
}

@article{wilcox_cost_nodate-1,
	title = {Cost {Analysis} of {Carbon} {Capture} and {Storage} of {Process} {Emissions} from the {US} {Industrial} {Sector}},
	abstract = {The industrial sector represents roughly 22\% of US emissions. Unlike emissions from the exhaust
streams of coal and natural gas-fired power plants, the carbon footprint of the industrial sector
represents a complex mixture of stationary combustion emissions and process emissions produced
as a reactionary byproduct of the creation of valuable commodities like cement, iron and steel,
glass, and oil. This study quantifies the potential opportunities for low-cost CCS scenarios with
process emissions from the US industrial sector by analyzing the variabilities in source types,
transportation and geographic proximity to relevant sinks, specifically enhanced oil recovery and
geologic storage. By decoupling stationary combustion emissions from each US industrial facility
and focusing solely on higher-purity process emission streams, this approach helps identify the
most cost-effective opportunities for each facility and ultimately a given sector of the broader
portfolio. Using a broad-reaching technology-agnostic cost model developed for CO₂ capture for
single-stream systems, full delivered costs are calculated for each industry describing capture,
compression, transportation to nearest CO₂-EOR and geologic storage opportunities, and
application of the US Federal Tax Credit (45Q) to qualifying facilities. This analysis shows that
capture of these targeted industrial process emission streams may lead to the avoidance of roughly
200 MtCO₂/a. Further, 123 facilties (i.e., 12\% of 1025 facilities considered) had a cost scenario that
fell below \$40/tCO₂ delivered, accounting for 68.5 million tonnes of CO₂ avoidance potential.
Finally, regional CO₂ collection hubs are explored as an option to leverage economies of scale in
pipeline transport scenarios. This analysis showed the US Midwest has the potential to be hub for
CO₂ capture and storage. Additionally, between the Louisiana-Mississippi and Texas-New Mexico
pipelines, there is the capacity to transport 40 Mt/a in captured CO₂ emissions from co-located
industry emitters.},
	language = {en},
	journal = {Energy \& Environmental Science},
	author = {Wilcox, Jennifer and Pilorgé, Hélène and McQueen, Noah and Maynard, Daniel and Psarras, Peter and He, Jiajun and Rufael, Tecle},
	file = {Wilcox et al. - Cost Analysis of Carbon Capture and Storage of Pro.pdf:files/5916/Wilcox et al. - Cost Analysis of Carbon Capture and Storage of Pro.pdf:application/pdf},
}

