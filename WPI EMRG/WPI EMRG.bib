	doi = {10.1016/0022-0248(71)90142-4},
	abstract = {Single crystals of MgO weighing 50 to 300 g each and having higher purity than previously available have been grown. Reuse of the cavity burned by the arc has reduced both the amount of the starting material required for each run and the chance of accidental contamination of runs using expensive or rare dopants. Starting powder of 99.98\% purity has yielded crystals of purity greater than 99.99\%. Bubbles 0.5 to 1 μm in diameter cause the cloudiness usually observed in pure MgO crystals. This cloudiness has been greatly reduced by sweeping the melt with a gas during crystal growth. The origin of the bubbles is discussed.},
	language = {en},
