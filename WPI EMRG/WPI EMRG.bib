}

@phdthesis{ludlow_influence_2007,
	address = {Manchester, UK},
	type = {En.{D}.},
	title = {The {Influence} of {Direct} {Chill} {Casting} {Parameters} on the {Structure} and {Properties} of {Magnesium} {Alloys}},
	url = {https://www.proquest.com/docview/2120463931},
	abstract = {Part of Magnesium Elektron’s continuous improvement programme is to upgrade its products and processes to enable it to maintain its position as a world leader. Current state-of-the-art DC casting technology used in the aluminium sector was redesigned so that it was capable of producing magnesium alloy billets. The main objectives of this project were to investigate the influence of the main casting parameters for two magnesium alloys and to develop a computer model of the process using commercial software.

A comprehensive literature review was written to support this work. The experimental design was based on the hot top short mould technology with 344mm diameter that contained thermocouples to study the temperature distribution. A casting trials matrix was devised to study the effect of the casting speed and water flow rate on the magnesium alloy billets. The AL80 and ZK60 alloys were chosen for their commercial importance and different characteristics.

Casting trials were undertaken with embedded thermocouples in the billets to collect temperature data. A 2D model was developed to simulate the experimental DC casting process using Flow 3D software and validated using temperature and sump data from the casting trials. The model was capable of predicting billet temperature, solidification and liquid fluid flow velocities. The model was then used to investigate the effects of heat transfer, casting parameters, material properties and process design. Increased casting speed increased mould temperatures, sump depth, folding and cracking in the ZK60 alloy billet. Changes in the water flow rate affected the mould temperatures. Changes in the casting speed and water flow rate had little effect on the alloy billet macro or microstructure, surface roughness or mechanical properties.

The analysis showed that process temperatures fluctuated and that mould cooling was not uniform and produced variations in shell thickness in the AL80 alloy billet. Cracking in the ZK60 alloy billet was caused by hot tearing andinitiated at surface anomalies caused by insufficient feeding making the material more susceptible to fracture. The measured and calculated results were similar to each other and differences were due to the estimated data and simplification of the process physics. The models predicted solidification fronts 20mm (billet centre) higher up the mould compared to the measured solidification fronts. This caused differences between the measured and calculated temperature data for the solidified billet.

The model confirmed that the sump could overshoot during the cast start and that a shell lip could be formed; this corresponded with the shell structure in the AL80 alloy. The model predicted fluid flow velocities in the sump to be an order of magnitude higher than the casting speed and were highest at the solidification front heading towards the mould wall. The results from the modelling work showed that variations in alloy thermophysical properties could have a significant impact on casting and that a reduced hot top diameter and increased stool heat transfer could be beneficial. Changes in the secondary cooling had little effect and the UCD should overlap with the primary cooling, i.e. near meniscus to avoid a run out. Suggestions are given for future work to improve the DC casting design and to improve billet quality and production.},
	language = {en},
	urldate = {2025-09-29},
	school = {University of Manchester},
	author = {Ludlow, Daved Barron},
	year = {2007},
	file = {out.pdf:files/3426/out.pdf:application/pdf},
}

@article{hasan_numerical_2014,
	title = {On numerical modeling of low-head direct chill ingot caster for magnesium alloy {AZ31}},
	volume = {2},
	issn = {22139567},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2213956714000747},
	doi = {10.1016/j.jma.2014.11.008},
	abstract = {A comprehensive 3D turbulent CFD study has been carried out to simulate a Low-Head (LH) vertical Direct Chill (DC) rolling ingot caster for the common magnesium alloy AZ31. The model used in this study takes into account the coupled laminar/turbulent melt ﬂow and solidiﬁcation aspects of the process and is based on the control-volume ﬁnite-difference approach. Following the aluminum/magnesium DC casting industrial practices, the LH mold is taken as 30 mm with a hot top of 60 mm. The previously veriﬁed in-house code has been modiﬁed to model the present casting process. Important quantitative results are obtained for four casting speeds, for three inlet melt pouring temperatures (superheats) and for three metal-mold contact heat transfer coefﬁcients for the steady state operational phase of the caster. The variable cooling water temperatures reported by the industry are considered for the primary and secondary cooling zones during the simulations. Speciﬁcally, the temperature and velocity ﬁelds, sump depth and sump proﬁles, mushy region thickness, solid shell thickness at the exit of the mold and axial temperature proﬁles at the center and at three strategic locations at the surface of the slab are presented and discussed.},
	language = {en},
	number = {4},
	urldate = {2025-09-29},
	journal = {Journal of Magnesium and Alloys},
	author = {Hasan, Mainul and Begum, Latifa},
	month = dec,
	year = {2014},
	pages = {275--286},
	file = {Hasan and Begum - 2014 - On numerical modeling of low-head direct chill ing.pdf:files/3427/Hasan and Begum - 2014 - On numerical modeling of low-head direct chill ing.pdf:application/pdf},
}

