@techreport{powell_clean_2017,
	address = {Natick, Massachusetts},
	type = {Department of {Energy} {ARPA}-{E} {Project} {Final} {Report}},
	title = {Clean {Efficient} {Aluminum} {Electrolysis} with {SOM} {Anodes}},
	url = {https://arpa-e.energy.gov/programs-and-initiatives/search-all-projects/aluminum-production-using-zirconia-solid-electrolyte},
	abstract = {This project covered two areas: use of INFINIUM Pure Oxygen Anodes™ for production of pure aluminum, and low-cost production of aluminum-scandium master alloy for high- performance alloys.

Pure Oxygen Anodes experiments and literature research identified key obstacles to long-term operation, and mitigated several of them. At this point, low-temperature operation in potassium cryolite with thin tubes and porous silver anodes seems the best route to long-term operation.

At this point, there is not a clear path to 4000 hours at 0.5-1 A/cm² performance, as would be required for large-scale commodity aluminum production with cost similar to carbon anodes. But there is likely a route to 250 hours at 0.25-0.5 A/cm², which could make this technology feasible for niche products e.g. aluminum-scandium master alloy.

The project did identify an alternative Pure Oxygen Anodes commercialization pathway in the form of recycling dross waste from aluminum casting operations. These anodes can potentially use molten salt bath with higher density than liquid aluminum, allowing long dross residence time for dissolution. INFINIUM is looking to pursue this pathway further with a large aluminum company.

Regarding production of Al-2\%Sc commercial master alloy composition for Al-Sc alloys, this project reached several findings around two production methods.

First, the team produced 10 kg of approximately 2 wt\% Sc in Al, which is the standard commercial master alloy composition. This confirmed existing literature showing that ScF₃ reacts with liquid Al metal to produce Al-Sc alloys. However, the high cost of ScF ₃ (60\% higher than Sc₂O₃, Sc basis), the low maximum observed yield of 27\% ScF₃ conversion, lack of novelty, and a prospective commercialization partner’s desire to avoid producing ScF₃ are challenges to moving forward with this method.

Second, this project demonstrated a novel process for direct electrolytic reduction of scandium oxide with a liquid aluminum cathode, with potentially the lowest possible raw material costs. This required the formulation of a low-density scandium-rich bath chemistry with sufficient oxide solubility for electrolysis, and understanding parallel metallothermic and electrolytic reactions. Here challenges to commercialization are all technical: carbon dust formation reduces current efficiency; using air to remove this carbon dust would damage cell materials of construction; harvesting alloy and replenishing the liquid aluminum cathode could remove bath and lead to scandium yield loss; and maintaining ideal bath composition will require control of Sc ₂O ₃ feed rate, current density, and idle time, such that frequent chemistry measurements may be necessary.

This report describes the high-temperature chemistry fundamentals involved in all of the above, plus about 70 of the experiments which contributed to further understanding of these phenomena, detailed narratives and schematic designs for industrial use of these processes, and preliminary cost estimates for these processes.},
	language = {en},
	urldate = {2025-10-24},
	institution = {INFINIUM, Inc.},
	author = {Powell, Adam},
	month = mar,
	year = {2017},
	file = {INFINIUM Aluminum Final Technical Report v8.1.pdf:files/3419/INFINIUM Aluminum Final Technical Report v8.1.pdf:application/pdf},
}

@article{narumi_observation_2025,
	title = {Observation of equiaxed dendrite growth and motion in {Al}-{Cu} alloy using {4D}-{CT}},
	volume = {1335},
	issn = {1757-8981, 1757-899X},
	url = {https://iopscience.iop.org/article/10.1088/1757-899X/1335/1/012005},
	doi = {10.1088/1757-899X/1335/1/012005},
	abstract = {Time-resolved computed tomography (4D-CT) was performed to observe the formation process of equiaxed grain structure in Al-5mass\%Cu alloy refined by inoculant TiB2 particles. The temporal resolution of as short as 1 s was achieved using a high-brilliance X-ray beam at a beamline BL20B2 of SPring-8 (Hyogo, Japan). A filtering method based on a phase field model was used to improve the quality of reconstructed images, evaluating equiaxed grain motion in conjunction with their dendritic growth. Nucleation events of α-Al was followed by the settlement of equiaxed grains. The moving velocity in the vertical direction was first -100 μm/s and then reduced to zero due to sedimentation at the bottom of the specimen as solidification proceeded. The solid fraction was 0.15 when the observation region was filled with stacked equiaxed grains. No nucleation events occurred in the remaining liquid phase between stacked equiaxed grains. 4D-CT observation demonstrates that the number and arrangement of equiaxed grains in the early stage of solidification determines the grain size distribution in the ascast microstructure.},
	language = {en},
	number = {1},
	urldate = {2025-10-23},
	journal = {IOP Conf. Ser.: Mater. Sci. Eng.},
	author = {Narumi, Taka and Shimokawa, Takahiro and Nakano, Sota and Katsube, Ryoji and Yasuda, Hideyuki},
	month = sep,
	year = {2025},
	pages = {012005},
	file = {Narumi et al. - 2025 - Observation of equiaxed dendrite growth and motion.pdf:files/3420/Narumi et al. - 2025 - Observation of equiaxed dendrite growth and motion.pdf:application/pdf},
}

