	doi = {10.1016/j.matchemphys.2016.01.012},
	abstract = {The phase equilibria of the MgePbeZn ternary system were investigated using electron probe microanalysis (EPMA), back scattered electron (BSE) imaging and X-ray diffraction (XRD) methods. Three isothermal sections of the MgePbeZn ternary system at 200  C, 300  C and 400  C were experimentally established. The phase equilibria of MgePb binary and MgePbeZn ternary system were thermodynamically assessed by using CALPHAD (Calculation of Phase Diagrams) method on the basis of the presently determined experimental data. A consistent set of thermodynamic parameters has been derived for describing the Gibbs free energies of each solution phase and intermetallic compound in the MgePb and MgePbeZn systems. The calculated phase diagrams and thermodynamic properties in the MgePb and MgePbeZn systems are in good agreement with experimental data.},
