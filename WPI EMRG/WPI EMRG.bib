@article{chen_review_2024,
	title = {A review of metal-carbon dioxide combustion},
	volume = {203},
	issn = {13640321},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1364032124004568},
	doi = {10.1016/j.rser.2024.114730},
	abstract = {The concept of combusting metals with carbon dioxide (CO2) presents a possible carbon dioxide reduction and utilization technology. Benefiting from high energy densities and low safety risks, metal fuels are promising energy carriers for renewable energy. Metal-oxygen and metal-steam combustion have been extensively studied, but metal-CO2 combustion, which has great potential to achieve negative carbon emissions, has not attracted enough attention yet. Metal powders or sprays can be burned in CO2 at temperatures appropriate for industrial practice. The metallic products of metal-CO2 combustion can be recycled back into metal fuels using renewable energy. Meanwhile, the solid carbon and carbon monoxide produced can be used for direct combustion or in fuel cells when CO2 recycling closes the carbon loop. Experiments, modelling work, and demonstrations of metal-CO2 combustion are reviewed in this work. On this basis, a metal-CO2 combustion cycle concept coupling the metalCO2 combustion, metal-fuel recycling, utilization of renewable energy, and processing of by-products is proposed.},
	language = {en},
	urldate = {2026-09-03},
	journal = {Renewable and Sustainable Energy Reviews},
	author = {Chen, Qianyun and Bergthorson, Jeffrey and Schiemann, Martin},
	month = oct,
	year = {2024},
	pages = {114730},
	file = {PDF:files/6432/Chen et al. - 2024 - A review of metal-carbon dioxide combustion.pdf:application/pdf},
}

