@article{thoma_phase_1961,
	title = {{PHASE} {EQUILIBRIA} {IN} {THE} {SYSTEM} {LiF}-{YF}₃},
	volume = {65},
	issn = {0022-3654, 1541-5740},
	url = {https://pubs.acs.org/doi/abs/10.1021/j100825a003},
	doi = {10.1021/j100825a003},
	abstract = {The phase equilibrium diagram of the condensed system LiF-YFg is presented. Data were obtained from thermal analysis of heating and cooling curves and by identifying the phases present in small samples which were quenched after equilibration at high temperatures. Within the system two invariant points occur, the eutectic at 19 mole \% YF₃ and 695°, and the peritectic at 49 mole \% YF₃ and 819°. The single intermediate compound, LiF-YF₃, is formed. It melts incongruently to YF₃ and liquid at 819°, and is tetragonal, a₀ = 5.26 ± 0.03 Å., and c₀ = 10.94 ± 0.03 Å., space group I4₁/a. The compound LiF-YF₃ is colorless, uniaxial (+), with refractive indices Nω = 1.454, Ns = 1.472. No solid solutions are formed among the equilibrium solids in the system LiF-YF₃. The melting point of YF₃, 1148°, determined by other workers, was corroborated in the present study.  A solid state transition in YF₃ was shown to occur at 1052°.},
	language = {en},
	number = {7},
	urldate = {2021-10-24},
	journal = {J. Phys. Chem.},
	author = {Thoma, R. E. and Weaver, C. F. and Friedman, H. A. and Insley, H. and Harris, L. A. and Yakel, H. A.},
	month = jul,
