	month = jan,
	year = {2023},
	pages = {253},
	file = {Du et al. - 2023 - An iron-base oxygen-evolution electrode for high-t.pdf:files/4001/Du et al. - 2023 - An iron-base oxygen-evolution electrode for high-t.pdf:application/pdf},
}

