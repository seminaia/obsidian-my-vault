@book{bauer_sfera_2018,
	title = {{SFERA} {II} {Project} {Deliverable} {D15}.4: {Report} on innovative techniques for molten salts high temperature measurements},
	shorttitle = {{SFERA} {II} {Project} {Deliverable} {D15}.4},
	doi = {10.13140/RG.2.2.21279.46249},
	abstract = {The present report is concerned with the description of the improvement of measurement techniques for molten salts as heat transfer fluid (HTF) and sensible thermal energy storage (TES) media at elevated temperatures (up to 700 °C). For concentrating solar power (CSP), the standard medium for TES is a mixture of Sodium Nitrate and Potassium
Nitrate. The thermal stability of this mixture limits the operation temperature (about 560 °C). At higher temperatures alternative TES media, such as chlorides or carbonates, are required.
This document aims for elevated TES operation up to 700 °C using an alternative molten mixture based on a ternary chloride salt mixture. In order to monitor the salt chemistry specifically an adapted measurement technique based on an electrochemical technique was developed. This allows for the extension of the measurement possibilities compared to known methods.
This report is organised as follows.
- Chapter 2 introduces molten chloride salts with a brief overview of relevant state-of-the-art literature with a special focus of the recent development in the area of CSP, as well as the chemistry of molten chlorides.
- Chapter 3 gives some theoretical background on measurement techniques for molten salt with special attention to in-situ electrochemical techniques
- Chapter 4 introduces the new experimental setup for molten chlorides with an operation temperature of more than 700 °C.
- Chapter 5 gives results of in-situ electrochemical techniques and salt post-analysis to monitor the impurity level in the molten chloride salt mixture.
- Chapter 6 summarises and concludes this report.},
	author = {Bauer, Thomas and Ding, Wenjin},
	month = jan,
	year = {2018},
	file = {Full Text PDF:files/3984/Bauer and Ding - 2018 - SFERA II Project Deliverable D15.4 Report on inno.pdf:application/pdf},
}

