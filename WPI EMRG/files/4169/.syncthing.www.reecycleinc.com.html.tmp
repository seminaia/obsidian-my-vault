 <div class="sqs-image-shape-container-element has-aspect-ratio" style=position:relative;padding-bottom:140.18692016601562%;overflow:hidden id=yui_3_17_2_1_1676812587832_126>
 
 <noscript><img src="https://images.squarespace-cdn.com/content/v1/61fec00301ec5b7bb87bc7e1/d3d39a9f-e525-409d-930d-b0aae2289497/wind-turbine-900.png" alt="Reecycle Inc."></noscript><img class="thumb-image loaded" data-src=https://images.squarespace-cdn.com/content/v1/61fec00301ec5b7bb87bc7e1/d3d39a9f-e525-409d-930d-b0aae2289497/wind-turbine-900.png data-image=https://images.squarespace-cdn.com/content/v1/61fec00301ec5b7bb87bc7e1/d3d39a9f-e525-409d-930d-b0aae2289497/wind-turbine-900.png data-image-dimensions=642x900 data-image-focal-point=0.5,0.5 data-load=false data-image-id=61ff408f6017302c6b597139 data-type=image style=left:0%;top:0%;width:100%;height:100%;position:absolute alt="Reecycle Inc." data-image-resolution=750w src="data:image/png;base64,">
 
