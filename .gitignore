# Obsidian config is device-specific and huge (194 MB of plugin binaries).
# Plugins travel between desktops over Syncthing; mobile uses .obsidian-mobile.
.obsidian/
.obsidian-mobile/

# Local Syncthing config and Fit cache.
.stignore
_fit/

# Copilot chat logs and local settings.
copilot/copilot-conversations/
.copilot/

# Obsidian local trash.
.trash/
