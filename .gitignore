# Never commit plugin settings that can contain credentials.
.obsidian/plugins/fit/data.json
.obsidian/plugins/tasknotes/data.json
.obsidian/plugins/github-sync/data.json
.obsidian/plugins/google-drive-sync/data.json

# Local Syncthing config and Fit cache.
.stignore
_fit/

# Copilot chat logs and local settings.
copilot/copilot-conversations/
.copilot/
.obsidian/plugins/copilot/data.json

# Plugin debug logs.
.obsidian/plugins/*/debug.log
