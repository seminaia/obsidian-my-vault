{
  "profile": "Calendar Home",
  "profileVersion": 1,
  "created": "2026-10-26",
  "description": "Homepage calendar/agenda setup for this vault: TaskNotes Bases calendar + agenda, TaskNotes ICS subscriptions, and the Homepage plugin that opens the agenda on startup.",
  "obsidian": {
    "version": "1.14.5"
  },
  "plugins": {
    "tasknotes": {
      "id": "tasknotes",
      "name": "TaskNotes",
      "version": "4.14.0",
      "minAppVersion": "1.12.2",
      "required": true,
      "source": "community"
    },
    "homepage": {
      "id": "homepage",
      "name": "Homepage",
      "version": "4.6.0",
      "minAppVersion": "1.13.0",
      "required": true,
      "source": "community"
    }
  },
  "homepageTarget": "TaskNotes/Views/agenda-default.base",
  "corePluginsRequired": [
    "bases",
    "daily-notes"
  ],
  "patch": {
    "script": "Scripts/reapply-tasknotes-ics-refresh-patch.sh",
    "marker": "tnIcsRefreshTimer",
    "appliesTo": ".obsidian/plugins/tasknotes/main.js",
    "summary": "Refetch open TaskNotes Bases calendars when the ICS subscription cache changes, debounced by 1s. Fixes empty calendars on cold start.",
    "note": "Plugin updates overwrite main.js. Re-run the patch script after updating TaskNotes, or re-run this profile's apply script."
  },
  "restoreScript": "Scripts/apply-calendar-home-profile.sh",
  "saveScript": "Scripts/save-calendar-home-profile.sh",
  "files": [
    {
      "path": ".obsidian/appearance.json",
