{
  "profile": "Calendar Home",
  "profileVersion": 2,
  "verified": "2026-10-26",
  "description": "Calendar/agenda homepage setup. The settings live at their real paths and are tracked by git, so this profile stores no copies; it records versions, the homepage target, and the one binary patch.",
  "obsidian": {
    "version": "1.14.5"
  },
  "plugins": {
    "tasknotes": {
      "id": "tasknotes",
      "name": "TaskNotes",
      "version": "4.14.0",
      "minAppVersion": "1.12.2",
      "required": true
    },
    "homepage": {
      "id": "homepage",
      "name": "Homepage",
      "version": "4.6.0",
      "minAppVersion": "1.13.0",
      "required": true
    }
  },
  "homepageTarget": "TaskNotes/Views/agenda-default.base",
  "corePluginsRequired": [
    "bases",
    "daily-notes"
  ],
  "settingsOfRecord": [
    ".obsidian/plugins/tasknotes/data.json",
    ".obsidian/plugins/homepage/data.json",
    ".obsidian/community-plugins.json",
    ".obsidian/core-plugins.json",
    ".obsidian/daily-notes.json",
    ".obsidian/appearance.json",
    ".obsidian/types.json",
    "TaskNotes/Views/agenda-default.base",
    "TaskNotes/Views/calendar-default.base",
    "TaskNotes/Views/mini-calendar-default.base",
    "TaskNotes/Views/tasks-default.base",
    "TaskNotes/Views/kanban-default.base",
    "TaskNotes/Views/pomodoro-stats.base",
    "TaskNotes/Views/relationships.base",
    "mdbase.yaml",
    "_types/task.md"
  ],
  "patch": {
    "script": "Scripts/reapply-tasknotes-ics-refresh-patch.sh",
    "marker": "tnIcsRefreshTimer",
    "appliesTo": ".obsidian/plugins/tasknotes/main.js",
    "summary": "Refetch open TaskNotes Bases calendars when the ICS subscription cache changes, debounced by 1s. Fixes empty calendars on cold start.",
    "note": "Plugin updates overwrite main.js. Re-run the patch script after updating TaskNotes, or run Scripts/calendar-home.sh --repair."
  },
  "scripts": {
    "verify": "Scripts/calendar-home.sh --check",
    "repair": "Scripts/calendar-home.sh --repair"
  }
}
